package templates

import (
	"strconv"

	"altalune.id/openwa/internal/web"
)

// WebhookSnippet is one signature verifier the console offers to copy.
type WebhookSnippet struct {
	Lang  string
	Label string
	Code  string
}

// WebhookGuideView carries what the integration guide quotes: header names, the attempt limit and the verifiers.
type WebhookGuideView struct {
	EventIDHeader    string
	DeliveryIDHeader string
	TimestampHeader  string
	SignatureHeader  string
	MaxAttempts      int
	TotalRetryHours  int
	FirstWaitSeconds int
	LongestWaitHours int
	Open             bool
	Snippets         []WebhookSnippet
}

templ webhookGuideStep(n int, text string) {
	<li class="flex items-start gap-3">
		<span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-[11px] font-semibold text-primary">{ strconv.Itoa(n) }</span>
		<span class="min-w-0 flex-1">{ text }</span>
	</li>
}

templ webhookGuideNote(text, header string) {
	<li class="flex items-start gap-3">
		<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-primary/40"></span>
		<span class="min-w-0 flex-1">
			{ text }
			if header != "" {
				<code class="ml-1 rounded bg-muted px-1 py-0.5 font-mono text-xs text-foreground">{ header }</code>
			}
		</span>
	</li>
}

// WebhookGuide is the "How to integrate" panel on the endpoint list; it opens by default while the project has no endpoints.
templ WebhookGuide(d web.LayoutData, g WebhookGuideView) {
	<details data-webhook-guide open?={ g.Open } class="mt-6 surface p-5">
		<summary class="cursor-pointer text-sm font-semibold text-foreground">{ d.Tr("webhooks.guide_heading") }</summary>
		<p class="mt-2 text-sm text-muted-foreground">{ d.Tr("webhooks.guide_intro") }</p>
		<ol class="mt-4 space-y-2 text-sm text-foreground/90">
			@webhookGuideStep(1, d.Tr("webhooks.guide_step_url"))
			@webhookGuideStep(2, d.Tr("webhooks.guide_step_events"))
			@webhookGuideStep(3, d.Tr("webhooks.guide_step_secret"))
			@webhookGuideStep(4, d.Tr("webhooks.guide_step_verify"))
			@webhookGuideStep(5, d.Tr("webhooks.guide_step_test"))
			@webhookGuideStep(6, d.Tr("webhooks.guide_step_inspect"))
			@webhookGuideStep(7, d.Tr("webhooks.guide_step_retry"))
		</ol>
		@webhookReceiverNotes(d, g)
	</details>
}

templ webhookReceiverNotes(d web.LayoutData, g WebhookGuideView) {
	<h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-muted-foreground">{ d.Tr("webhooks.guide_receiver_heading") }</h3>
	<ul class="mt-2 space-y-2 text-sm text-foreground/90">
		@webhookGuideNote(d.Tr("webhooks.guide_respond"), "")
		@webhookGuideNote(d.Tr("webhooks.guide_dedupe"), g.DeliveryIDHeader)
		@webhookGuideNote(d.Tr("webhooks.guide_correlate"), g.EventIDHeader)
		@webhookGuideNote(d.Tr("webhooks.guide_retries", "Attempts", g.MaxAttempts, "TotalHours", g.TotalRetryHours, "FirstSeconds", g.FirstWaitSeconds, "LongestHours", g.LongestWaitHours), "")
	</ul>
}

templ webhookSnippetPanel(d web.LayoutData, s WebhookSnippet) {
	<div class="flex justify-end">
		@CopyButton(d, s.Code, d.Tr("webhooks.verify_copy_label", "Lang", s.Label))
	</div>
	<pre class="mt-1 max-h-96 overflow-auto rounded border border-border/70 bg-background p-2 font-mono text-xs text-foreground"><code>{ s.Code }</code></pre>
}

func webhookSnippetTabs(d web.LayoutData, g WebhookGuideView) TabsProps {
	tabs := make([]Tab, 0, len(g.Snippets))
	for _, s := range g.Snippets {
		tabs = append(tabs, Tab{Key: s.Lang, Label: s.Label, Panel: webhookSnippetPanel(d, s), Attrs: templ.Attributes{"data-snippet": s.Lang}})
	}
	return TabsProps{ID: "webhook-verify", Label: d.Tr("webhooks.verify_languages"), Tabs: tabs}
}

// WebhookVerifyPanel is the collapsible "Verify signatures" section: one copyable verifier per language, switched by tabs.
templ WebhookVerifyPanel(d web.LayoutData, g WebhookGuideView) {
	<details data-webhook-verify class="mt-6 surface p-5">
		<summary class="cursor-pointer text-sm font-semibold text-foreground">{ d.Tr("webhooks.verify_heading") }</summary>
		<p class="mt-2 text-sm text-muted-foreground">{ d.Tr("webhooks.verify_intro") }</p>
		<p class="mt-2 flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
			<span>{ d.Tr("webhooks.verify_headers_label") }</span>
			<code class="rounded bg-muted px-1 py-0.5 font-mono text-foreground">{ g.TimestampHeader }</code>
			<code class="rounded bg-muted px-1 py-0.5 font-mono text-foreground">{ g.SignatureHeader }</code>
		</p>
		<p class="mt-2 text-xs text-muted-foreground">{ d.Tr("webhooks.verify_env") }</p>
		if len(g.Snippets) > 0 {
			<div class="mt-3">
				@Tabs(d, webhookSnippetTabs(d, g))
			</div>
		}
		@webhookReceiverNotes(d, g)
	</details>
}
