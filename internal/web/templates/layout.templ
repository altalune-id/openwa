package templates

import (
	"altalune.id/openwa/internal/web"
	"altalune.id/openwa/internal/web/icons"
)

templ Layout(d web.LayoutData) {
	<!DOCTYPE html>
	<html
		lang={ layoutLang(d) }
		dir={ layoutDir(d) }
		if d.ThemeAttr != "" {
			data-theme={ d.ThemeAttr }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ d.DocumentTitle() }</title>
			<link rel="icon" type="image/svg+xml" href={ d.Static(brandIcon) }/>
			<link rel="icon" type="image/png" sizes="32x32" href={ d.Static("favicon-32x32.png") }/>
			<link rel="icon" type="image/png" sizes="16x16" href={ d.Static("favicon-16x16.png") }/>
			<link rel="apple-touch-icon" href={ d.Static("apple-touch-icon.png") }/>
			@ThemeMetas(d)
			if d.CSPEnforced {
				<!-- SECURITY: whitelists the one extension we load, so a stray script cannot register another. -->
				<meta name="htmx-config" content="extensions:&#34;hx-csp&#34;"/>
			}
			<link rel="stylesheet" href={ d.Static("app.css") }/>
			<script src={ d.Static("htmx.min.js") } nonce={ d.Nonce } defer></script>
			if d.CSPEnforced {
				<script src={ d.Static("hx-csp.min.js") } nonce={ d.Nonce } defer></script>
			}
			@htmxRequestHooks(d.Nonce)
			<script src={ d.Static("dialog.js") } nonce={ d.Nonce } defer></script>
			<script src={ d.Static("dropdown.js") } nonce={ d.Nonce } defer></script>
			<script src={ d.Static("tips.js") } nonce={ d.Nonce } defer></script>
			<script src={ d.Static("copy.js") } nonce={ d.Nonce } defer></script>
			<script src={ d.Static("localtime.js") } nonce={ d.Nonce } defer></script>
		</head>
		<body class="min-h-dvh bg-base-200 font-sans text-base-content antialiased">
			<a href="#main" class="btn btn-sm sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50">{ d.Tr("nav.skip_to_content") }</a>
			if hasShell(d) {
				<div class="drawer lg:drawer-open">
					<input id="alt-drawer" type="checkbox" class="drawer-toggle" tabindex="-1" autocomplete="off" aria-label={ d.Tr("nav.open_menu") }/>
					<div class="drawer-content flex min-h-dvh min-w-0 flex-col">
						@shellNavbar(d)
						<main id="main" tabindex="-1" class="w-full max-w-6xl flex-1 p-4 outline-none lg:px-8 lg:py-6">
							@Breadcrumb(d)
							@pageNotices(d)
							@d.Content
						</main>
					</div>
					<div class="drawer-side z-40">
						<label for="alt-drawer" aria-label={ d.Tr("nav.close_menu") } class="drawer-overlay"></label>
						@rail(d)
					</div>
				</div>
			} else {
				@topNav(d)
				<main id="main" tabindex="-1" class="mx-auto max-w-6xl px-4 py-6 outline-none md:py-10">
					@pageNotices(d)
					@d.Content
					if d.Principal == nil && len(d.SupportedLocs) > 1 {
						@publicLocaleFooter(d)
					}
				</main>
			}
			@ToastHost(d)
			@dialogHost(d)
		</body>
	</html>
}

templ dialogHost(d web.LayoutData) {
	<div id="dialog-host" hx-morph-skip hx-nonce={ d.Nonce }>
		if hasShell(d) {
			@switcherSheet(d)
		}
		if d.Dialogs != nil {
			@d.Dialogs
		}
	</div>
}

func hasShell(d web.LayoutData) bool {
	return d.Principal != nil && d.ActiveNav.Scope != web.NavScopeNone
}

templ pageNotices(d web.LayoutData) {
	<div id="hx-error" class="mb-4 empty:hidden empty:mb-0" aria-live="polite"></div>
}

templ topNav(d web.LayoutData) {
	<header class="navbar sticky top-0 z-30 min-h-14 border-b border-base-300 bg-base-100 px-4 md:px-6">
		<div class="navbar-start">
			<a href={ templ.SafeURL(d.Href("/")) } class="flex items-center gap-2">
				@brandMark("size-7")
				@brandName(d.BrandName)
			</a>
		</div>
		<div class="navbar-end">
			if d.Principal == nil {
				@AppDropdown(modeTrigger(d), d.Tr("theme.mode"), "", "btn-ghost lg:btn-sm", "end-0 top-full mt-1 max-h-[70dvh] w-64 overflow-y-auto") {
					@ThemePicker(d)
				}
			} else if d.Principal.Email != "" {
				@userMenu(d, "", "btn-ghost max-w-60 justify-start lg:btn-sm", "end-0 top-full mt-1 w-64")
			}
		</div>
	</header>
}

templ modeTrigger(d web.LayoutData) {
	@modeIcon(d.Theme.Mode)
	<span class="max-sm:sr-only">{ d.Tr(themeModeKey(d.Theme.Mode)) }</span>
}

templ modeIcon(m string) {
	switch m {
		case web.ModeLight:
			@icons.Icon("sun", "size-4")
		case web.ModeDark:
			@icons.Icon("moon", "size-4")
		default:
			@icons.Icon("monitor", "size-4")
	}
}

templ shellNavbar(d web.LayoutData) {
	<header class="navbar sticky top-0 z-30 min-h-14 gap-1 border-b border-base-300 bg-base-100 px-4 py-1.5 lg:hidden">
		<label for="alt-drawer" role="button" tabindex="0" aria-expanded="false" data-drawer-toggle class="btn btn-ghost btn-square drawer-button" aria-label={ d.Tr("nav.open_menu") }>
			@icons.Icon("menu", "size-5")
		</label>
		<div class="min-w-0 flex-1">
			@switcherPhoneTrigger(d)
		</div>
	</header>
}

templ rail(d web.LayoutData) {
	<aside class="flex min-h-full w-72 max-w-[86vw] flex-col gap-4 border-e border-base-300 bg-base-100 p-4 lg:h-dvh lg:w-64">
		<a href={ templ.SafeURL(d.Href("/")) } class="flex shrink-0 items-center gap-2 px-3">
			@brandMark("size-7")
			@brandName(d.BrandName)
		</a>
		@switcherRail(d)
		<ul class="menu min-h-0 w-full grow flex-nowrap gap-1 overflow-y-auto p-0 max-lg:[&_a]:min-h-11 max-lg:[&_a]:content-center max-lg:[&_summary]:min-h-11 max-lg:[&_summary]:content-center">
			switch d.ActiveNav.Scope {
				case web.NavScopeProject:
					@projectMenu(d)
				case web.NavScopeSettings:
					@settingsMenu(d)
					@orgMenu(d)
				default:
					@orgMenu(d)
			}
		</ul>
		if d.ActiveNav.Scope == web.NavScopeProject && d.ActiveProject != nil {
			<ul class="menu w-full shrink-0 gap-1 border-t border-base-300 p-0 pt-3 max-lg:[&_a]:min-h-11 max-lg:[&_a]:content-center">
				for _, it := range projectFooterNav() {
					if it.Org {
						@menuLink(d.OrgPath(it.Path), it.Icon, d.Tr(it.LabelKey), false)
					} else {
						@menuLink(d.ProjectPath(d.ActiveProject.Slug, it.Path), it.Icon, d.Tr(it.LabelKey), d.ProjectMenuActive(it.Key))
					}
				}
			</ul>
		}
		@railFooter(d)
	</aside>
}

templ menuLink(href, icon, label string, active bool) {
	<li>
		<a
			href={ templ.SafeURL(href) }
			if active {
				class="menu-active"
				aria-current="page"
			}
		>
			@icons.Icon(icon, "size-4 shrink-0")
			<span class="truncate">{ label }</span>
		</a>
	</li>
}

templ projectMenu(d web.LayoutData) {
	if p := d.ActiveProject; p != nil {
		for _, g := range projectNav() {
			if g.LabelKey == "" {
				for _, it := range g.Items {
					@menuLink(d.ProjectPath(p.Slug, it.Path), it.Icon, d.Tr(it.LabelKey), d.ProjectMenuActive(it.Key))
				}
			} else if g.Collapsed {
				<li class="mt-1">
					<details open?={ groupActive(d, g) }>
						<summary>
							@icons.Icon("code", "size-4 shrink-0")
							<span class="truncate">{ d.Tr(g.LabelKey) }</span>
						</summary>
						<ul>
							for _, it := range g.Items {
								@menuLink(d.ProjectPath(p.Slug, it.Path), it.Icon, d.Tr(it.LabelKey), d.ProjectMenuActive(it.Key))
							}
						</ul>
					</details>
				</li>
			} else {
				<li class="menu-title mt-1 flex h-8 justify-center px-3 py-0">{ d.Tr(g.LabelKey) }</li>
				for _, it := range g.Items {
					@menuLink(d.ProjectPath(p.Slug, it.Path), it.Icon, d.Tr(it.LabelKey), d.ProjectMenuActive(it.Key))
				}
			}
		}
	} else {
		<li class="menu-title flex h-8 justify-center px-3 py-0">{ d.Tr("common.project") }</li>
		@menuLink(d.OrgPath("/projects/new"), "plus", d.Tr("nav.create_project"), false)
	}
}

func groupActive(d web.LayoutData, g navGroup) bool {
	for _, it := range g.Items {
		if d.ProjectMenuActive(it.Key) {
			return true
		}
	}
	return false
}

templ settingsMenu(d web.LayoutData) {
	<li class="menu-title flex h-8 justify-center px-3 py-0">{ d.Tr("nav.settings") }</li>
	@menuLink(d.Href("/settings/tokens"), "key", d.Tr("nav.personal_tokens"), d.ActiveNav.SettingsKey == "tokens")
}

templ orgMenu(d web.LayoutData) {
	if o := d.ActiveOrg; o != nil {
		<li class="menu-title mt-1 flex h-8 justify-center truncate px-3 py-0">{ o.Name }</li>
		@orgLinks(d, o.Slug)
	} else {
		<li class="menu-title mt-1 flex h-8 justify-center px-3 py-0">{ d.Tr("common.workspace") }</li>
		@menuLink(d.Href("/orgs/new"), "plus", d.Tr("nav.create_organization"), false)
	}
}

templ orgLinks(d web.LayoutData, slug string) {
	@menuLink(d.Href("/orgs/"+slug), "layout-dashboard", d.Tr("nav.overview"), d.ActiveNav.OrgKey == "overview")
	@menuLink(d.OrgPath("/projects"), "folder", d.Tr("nav.projects"), d.ActiveNav.OrgKey == "projects")
	@menuLink(d.Href("/orgs/"+slug+"/members"), "users", d.Tr("nav.members"), d.ActiveNav.OrgKey == "members")
	@menuLink(d.Href("/orgs/"+slug+"/invites"), "mail", d.Tr("nav.invites"), d.ActiveNav.OrgKey == "invites")
	@menuLink(d.Href("/orgs/"+slug+"/apikeys"), "key", d.Tr("nav.apikeys"), d.ActiveNav.OrgKey == "apikeys")
}

const railRow = "btn-ghost h-11 min-h-11 w-full list-none justify-start gap-2 border-0 px-3 text-sm font-normal [&::-webkit-details-marker]:hidden"

templ railChevron() {
	@icons.Icon("chevron-down", "ms-auto size-4 shrink-0 transition-transform group-open:rotate-180")
}

templ railFooter(d web.LayoutData) {
	<div class="flex flex-col gap-2 border-t border-base-300 pt-3">
		<details id="appearance" class="group w-full">
			<summary class={ "btn", railRow }>
				<span class="grid size-4 shrink-0 place-items-center">
					@icons.Icon("palette", "size-4")
				</span>
				<span class="truncate">{ d.Tr("theme.mode") }</span>
				@railChevron()
			</summary>
			<div class="p-3">
				@ThemePicker(d)
			</div>
		</details>
		if len(d.SupportedLocs) > 1 {
			@localeMenu(d, "dropdown-top group w-full", railRow, "bottom-full start-0 mb-1 w-full")
		}
		if d.Principal.Email != "" {
			@userMenu(d, "dropdown-top group w-full", railRow, "bottom-full start-0 mb-1 w-full")
		}
	</div>
}

templ publicLocaleFooter(d web.LayoutData) {
	<div class="mt-10 flex justify-center">
		@localeMenu(d, "dropdown-top", "btn-ghost w-56 justify-start lg:btn-sm", "bottom-full start-0 mb-1 w-56")
	</div>
}

templ localeTrigger(d web.LayoutData) {
	<span class="grid size-4 shrink-0 place-items-center">
		@icons.Icon("globe", "size-4")
	</span>
	<span class="truncate">{ d.LocaleLabel() }</span>
	@railChevron()
}

templ localeMenu(d web.LayoutData, class, triggerClass, contentClass string) {
	<form id="alt-locale" method="post" action={ templ.SafeURL(d.Href("/locale")) } class="hidden">
		<input type="hidden" name="redirect" value={ d.CurrentPath }/>
	</form>
	@AppDropdown(localeTrigger(d), d.Tr("common.language"), class, triggerClass, contentClass) {
		<ul class="menu w-full p-0 max-lg:[&_button]:min-h-11 max-lg:[&_button]:content-center">
			for _, opt := range d.LocaleOptions() {
				<li>
					<button
						type="submit"
						form="alt-locale"
						name="locale"
						value={ opt.Code }
						lang={ opt.Code }
						if opt.Active {
							class="menu-active"
							aria-current="true"
						}
					>
						{ opt.Native }
					</button>
				</li>
			}
		</ul>
	}
}

templ userTrigger(d web.LayoutData) {
	@Avatar(d.Principal.Email, "size-6 text-xs")
	<span class="min-w-0 truncate" dir="ltr">{ d.Principal.Email }</span>
	@railChevron()
}

templ userMenu(d web.LayoutData, class, triggerClass, contentClass string) {
	<form id="alt-logout" method="post" action={ templ.SafeURL(d.Href("/logout")) } class="hidden"></form>
	@AppDropdown(userTrigger(d), d.Tr("common.account_menu"), class, triggerClass, contentClass) {
		<div class="px-3 py-2">
			<p class="text-xs font-medium text-base-content/70">{ d.Tr("common.signed_in_as") }</p>
			<p class="truncate text-sm font-medium" dir="ltr">{ d.Principal.Email }</p>
		</div>
		<ul class="menu w-full p-0 max-lg:[&_a]:min-h-11 max-lg:[&_a]:content-center max-lg:[&_button]:min-h-11 max-lg:[&_button]:content-center">
			@menuLink(d.Href("/settings/tokens"), "settings", d.Tr("nav.settings"), false)
			<li>
				<button type="submit" form="alt-logout">
					@icons.Icon("log-out", "size-4")
					<span>{ d.Tr("common.sign_out") }</span>
				</button>
			</li>
		</ul>
		if d.Version != "" {
			<p class="border-t border-base-300 px-3 pt-2 text-xs text-base-content/70">{ d.BrandName } { d.Version }</p>
		}
	}
}

// SECURITY: this replaces per-element hx-on handlers so script-src needs no 'unsafe-eval'.
templ htmxRequestHooks(nonce string) {
	<script nonce={ nonce }>
	document.addEventListener('htmx:after:request', function(e) {
		var ctx = e.detail && e.detail.ctx;
		var status = ctx && ctx.response && ctx.response.status;
		if (typeof status !== 'number' || status >= 400) return;
		var banner = document.getElementById('hx-error');
		if (banner) banner.replaceChildren();
		var elt = e.target || (ctx && ctx.sourceElement);
		if (!elt || !elt.getAttribute) return;
		if (elt.hasAttribute('data-reset-on-success') && elt.reset) elt.reset();
		var sel = elt.getAttribute('data-clear-on-success');
		if (sel) {
			document.querySelectorAll(sel).forEach(function(i) { i.value = ''; });
		}
	});
	</script>
}

func layoutLang(d web.LayoutData) string {
	if s := string(d.Locale); s != "" {
		return s
	}
	return "en"
}

func layoutDir(d web.LayoutData) string {
	if d.Dir != "" {
		return d.Dir
	}
	return "ltr"
}
