package templates

import "altalune.id/openwa/internal/web"

type LoginView struct {
	Error      string
	ErrorCode  string
	Message    string
	ReturnTo   string
	LastEmail  string
	AdminForce bool
	LocalAuth  bool
}

templ LoginPage(d web.LayoutData, v LoginView) {
	<section class="mx-auto max-w-sm">
		<h1 class="text-center text-2xl font-semibold tracking-tight text-foreground">{ d.Tr("login.title") }</h1>
		if v.Message != "" {
			<div role="status" class="mt-4 rounded-md border border-success/30 bg-success/10 p-3 text-sm text-foreground">{ v.Message }</div>
		}
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if d.Caps.ExternalIdentity && !v.AdminForce {
			if v.LastEmail != "" {
				<a class="btn-sso mt-6" title={ d.Tr("login.continue_as") + " " + v.LastEmail } href={ templ.SafeURL(d.Href("/login/oidc?return_to=" + v.ReturnTo)) }>
					<img class="btn-sso__logo" src={ d.OIDCButtonLogoURL() } alt="" aria-hidden="true" width="24" height="24"/>
					<span class="btn-sso__label">{ d.Tr("login.continue_as") } { v.LastEmail }</span>
					<span class="btn-sso__chev" aria-hidden="true">→</span>
				</a>
				<p class="mt-3 text-center text-sm text-muted-foreground">
					<a class="hover:underline" href={ templ.SafeURL(d.Href("/login/oidc?switch=1&return_to=" + v.ReturnTo)) }>{ d.Tr("login.switch_account") }</a>
				</p>
			} else {
				<a class="btn-sso mt-6" href={ templ.SafeURL(d.Href("/login/oidc?return_to=" + v.ReturnTo)) }>
					<img class="btn-sso__logo" src={ d.OIDCButtonLogoURL() } alt="" aria-hidden="true" width="24" height="24"/>
					<span class="btn-sso__label">{ d.OIDCButtonLabel(d.Tr("login.oidc_button")) }</span>
					<span class="btn-sso__chev" aria-hidden="true">→</span>
				</a>
			}
			if v.LocalAuth {
				<div class="mt-6 text-center">
					<a href={ templ.SafeURL(d.Href("/admin-login")) } class="text-sm text-muted-foreground hover:underline">{ d.Tr("login.admin_link") }</a>
				</div>
			}
		}
		if v.LocalAuth && (v.AdminForce || !d.Caps.ExternalIdentity) {
			<form method="post" action={ templ.SafeURL(d.Href("/login")) } class="mt-6 space-y-4">
				if v.ReturnTo != "" {
					<input type="hidden" name="return_to" value={ v.ReturnTo }/>
				}
				if v.AdminForce {
					<input type="hidden" name="admin" value="1"/>
				}
				{{ emailField := FieldProps{ID: "email", Label: d.Tr("login.email"), Required: true} }}
				{{ passwordField := FieldProps{ID: "password", Label: d.Tr("login.password"), Required: true} }}
				@Field(d, emailField) {
					<input name="email" type="email" autocomplete="username" class={ InputClass() } { InputAttrs(emailField)... }/>
				}
				@Field(d, passwordField) {
					<input name="password" type="password" autocomplete="current-password" class={ InputClass() } { InputAttrs(passwordField)... }/>
				}
				<button type="submit" class={ ButtonClass(ButtonPrimary), "w-full justify-center" }>{ d.Tr("login.submit") }</button>
			</form>
		}
		if !v.LocalAuth && !d.Caps.ExternalIdentity {
			<p class="mt-6 text-center text-sm text-muted-foreground">{ d.Tr("login.no_method") }</p>
		}
	</section>
}

templ LoginLayout(d web.LayoutData, v LoginView) {
	@Layout(web.WithContent(d, LoginPage(d, v)))
}
