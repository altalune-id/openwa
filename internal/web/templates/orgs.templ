package templates

import "altalune.id/openwa/internal/web"

type OrgsView struct {
	Orgs      []OrgSummary
	Error     string
	ErrorCode string
}

templ orgsActions(d web.LayoutData) {
	if d.Caps.OrgCreation {
		@Button(ButtonProps{Kind: ButtonPrimary, Icon: "plus", Label: d.Tr("nav.new_organization"), Href: d.Href("/orgs/new")})
	}
}

templ OrgsPage(d web.LayoutData, v OrgsView) {
	<section>
		@PageHeader(d, PageHeaderProps{Title: d.Tr("orgs.title"), Subtitle: d.Tr("orgs.subtitle"), Actions: orgsActions(d)})
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if len(v.Orgs) == 0 {
			@EmptyState(d, EmptyStateProps{Icon: "building-2", Title: d.Tr("orgs.empty_title"), Body: d.Tr("orgs.empty_body"), CTA: orgsEmptyCTA(d)})
		} else {
			@ListShell(d, "org-list", nil) {
				for _, o := range v.Orgs {
					@ListRow(d, nil) {
						<div class="min-w-0 flex-1">
							<p class="flex items-center gap-2 truncate text-sm font-medium text-foreground">
								<span class="truncate">{ o.Name }</span>
								if o.System {
									@Badge(ToneWarning, d.Tr("common.system"))
								}
							</p>
							<p class="truncate text-xs text-muted-foreground">{ o.Slug }</p>
						</div>
						@Button(ButtonProps{Kind: ButtonGhost, Label: d.Tr("common.open"), Href: d.Href("/orgs/" + o.Slug + "/projects")})
					}
				}
			}
		}
	</section>
}

func orgsEmptyCTA(d web.LayoutData) *ButtonProps {
	if !d.Caps.OrgCreation {
		return nil
	}
	return &ButtonProps{Kind: ButtonPrimary, Label: d.Tr("orgs.create_first"), Href: d.Href("/orgs/new")}
}

templ OrgsLayout(d web.LayoutData, v OrgsView) {
	@Layout(web.WithContent(d, OrgsPage(d, v)))
}
