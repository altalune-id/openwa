package templates

import (
	"strconv"

	"altalune.id/openwa/internal/web"
)

type WebhookEventOption struct {
	Value    string
	LabelKey string
	Checked  bool
}

type WebhookFormView struct {
	ProjectSlug    string
	ID             string
	URL            string
	Description    string
	Active         bool
	Events         []WebhookEventOption
	MaxURLLen      int
	MaxDescription int
	Error          WebhookError
}

func webhookFormAction(d web.LayoutData, f WebhookFormView) string {
	if f.ID == "" {
		return d.ProjectPath(f.ProjectSlug, "/webhooks")
	}
	return d.ProjectPath(f.ProjectSlug, "/webhooks/"+f.ID)
}

templ webhookForm(d web.LayoutData, f WebhookFormView) {
	{{ urlField := FieldProps{ID: "webhook-url", Label: d.Tr("webhooks.url_label"), Help: d.Tr("webhooks.url_help"), Required: true} }}
	{{ descField := FieldProps{ID: "webhook-description", Label: d.Tr("webhooks.description_label")} }}
	@Card(CardProps{}) {
		<form
			method="post"
			action={ templ.SafeURL(webhookFormAction(d, f)) }
			if f.ID == "" {
				hx-post={ webhookFormAction(d, f) }
				hx-nonce={ d.Nonce }
				hx-target="#webhook-page"
				hx-swap="outerHTML"
				hx-disable="find button, find input"
				hx-status:5xx="target:#hx-error swap:innerHTML"
			}
			class="space-y-4"
		>
			@webhookErrorBanner(d, f.Error)
			@Field(d, urlField) {
				<input name="url" type="url" maxlength={ strconv.Itoa(f.MaxURLLen) } value={ f.URL } placeholder="https://example.com/hooks/openwa" class={ InputClass(), "font-mono" } { InputAttrs(urlField)... }/>
			}
			@Field(d, descField) {
				<input name="description" type="text" maxlength={ strconv.Itoa(f.MaxDescription) } value={ f.Description } class={ InputClass() } { InputAttrs(descField)... }/>
			}
			<fieldset>
				<legend class="block text-sm font-medium text-foreground">{ d.Tr("webhooks.events_label") }</legend>
				<div class="mt-1.5 flex flex-wrap gap-2">
					for _, opt := range f.Events {
						@Chip(ChipProps{Name: "event_types", Value: opt.Value, Label: d.Tr(opt.LabelKey) + " · " + opt.Value, Checked: opt.Checked})
					}
				</div>
			</fieldset>
			if f.ID != "" {
				<label class="inline-flex items-center gap-2 text-sm text-foreground">
					<input type="checkbox" name="active" value="1" checked?={ f.Active } class="h-3.5 w-3.5 rounded border-border"/>
					<span>{ d.Tr("webhooks.active_label") }</span>
				</label>
			}
			<div>
				if f.ID == "" {
					@Button(ButtonProps{Kind: ButtonPrimary, Type: "submit", Icon: "plus", Label: d.Tr("webhooks.create")})
				} else {
					@Button(ButtonProps{Kind: ButtonPrimary, Type: "submit", Label: d.Tr("webhooks.save")})
				}
			</div>
		</form>
	}
}

templ WebhookNewPage(d web.LayoutData, f WebhookFormView) {
	<section id="webhook-page">
		@PageHeader(d, PageHeaderProps{
			Eyebrow:  d.Tr("nav.webhooks"),
			Title:    d.Tr("webhooks.new_title"),
			Subtitle: d.Tr("webhooks.new_subtitle"),
			Actions:  Button(ButtonProps{Kind: ButtonGhost, Label: d.Tr("webhooks.back"), Href: d.ProjectPath(f.ProjectSlug, "/webhooks")}),
		})
		@webhookForm(d, f)
	</section>
}

templ WebhookNewLayout(d web.LayoutData, f WebhookFormView) {
	@Layout(web.WithContent(d, WebhookNewPage(d, f)))
}
