package templates

import (
	"strconv"

	"altalune.id/openwa/internal/web"
)

type WebhookEventOption struct {
	Value       string
	LabelKey    string
	Checked     bool
	Recommended bool
	DeviceBound bool
}

// WebhookDeviceOption is one project number a webhook can be scoped to.
type WebhookDeviceOption struct {
	PublicID string
	Name     string
	Phone    string
	Selected bool
}

// WebhookFormView renders the create and edit form; DeviceLocked shows the number read-only, as it never changes after create.
type WebhookFormView struct {
	ProjectSlug    string
	ID             string
	URL            string
	Description    string
	Active         bool
	Events         []WebhookEventOption
	Devices        []WebhookDeviceOption
	DeviceLocked   bool
	DeviceName     string
	DevicePublicID string
	MaxURLLen      int
	MaxDescription int
	Error          WebhookError
}

func webhookFormAction(d web.LayoutData, f WebhookFormView) string {
	if f.ID == "" {
		return d.ProjectPath(f.ProjectSlug, "/webhooks")
	}
	return d.ProjectPath(f.ProjectSlug, "/webhooks/"+f.ID)
}

func webhookCancelHref(d web.LayoutData, f WebhookFormView) string {
	if f.ID == "" {
		return d.ProjectPath(f.ProjectSlug, "/webhooks")
	}
	return d.ProjectPath(f.ProjectSlug, "/webhooks/"+f.ID)
}

func deviceOptionLabel(o WebhookDeviceOption) string {
	if o.Phone == "" {
		return o.Name
	}
	return o.Name + " (" + o.Phone + ")"
}

templ webhookDeviceField(d web.LayoutData, f WebhookFormView) {
	if f.DeviceLocked {
		<dl class="grid min-w-0 gap-2">
			@KeyValue(d.Tr("webhooks.number_label")) {
				<span class="flex min-w-0 flex-col gap-1">
					<span>
						@webhookNumber(d, f.DeviceName)
					</span>
					if f.DevicePublicID != "" {
						<code dir="ltr" class="font-mono text-xs break-all text-base-content/70 text-start">{ f.DevicePublicID }</code>
					}
					<span class="text-xs text-base-content/70">{ d.Tr("webhooks.number_locked_help") }</span>
				</span>
			}
		</dl>
	} else {
		{{ field := FieldProps{ID: "webhook-device", Label: d.Tr("webhooks.number_label"), Help: d.Tr("webhooks.number_help")} }}
		@FormField(d, field) {
			<select name="device" class="select w-full sm:max-w-sm lg:select-sm" { InputAttrs(field)... }>
				<option value="">{ d.Tr("webhooks.all_numbers") }</option>
				for _, o := range f.Devices {
					<option value={ o.PublicID } selected?={ o.Selected } dir="auto">{ deviceOptionLabel(o) }</option>
				}
			</select>
		}
	}
}

templ webhookEventRow(d web.LayoutData, opt WebhookEventOption) {
	<label class="flex min-h-11 cursor-pointer items-start gap-3 py-1 lg:min-h-8">
		<input type="checkbox" name="event_types" value={ opt.Value } checked?={ opt.Checked } class="checkbox checkbox-sm mt-0.5"/>
		<span class="flex min-w-0 flex-col gap-0.5">
			<span class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
				{ d.Tr(opt.LabelKey) }
				if opt.Recommended {
					@Badge(TonePrimary, d.Tr("common.recommended"))
				}
			</span>
			<code dir="ltr" class="font-mono text-xs text-base-content/70 text-start">{ opt.Value }</code>
		</span>
	</label>
}

templ webhookForm(d web.LayoutData, f WebhookFormView) {
	{{ urlField := FieldProps{ID: "webhook-url", Label: d.Tr("webhooks.url_label"), Help: d.Tr("webhooks.url_help"), Required: true} }}
	{{ descField := FieldProps{ID: "webhook-description", Label: d.Tr("webhooks.description_label")} }}
	<form
		method="post"
		action={ templ.SafeURL(webhookFormAction(d, f)) }
		if f.ID == "" {
			hx-post={ webhookFormAction(d, f) }
			hx-nonce={ d.Nonce }
			hx-target="#webhook-page"
			hx-swap="outerHTML"
			hx-disable="find button, find input, find select"
			hx-status:5xx="target:#hx-error swap:innerHTML"
		}
		class="card min-w-0 border border-base-300 bg-base-100"
	>
		<div class="card-body min-w-0 gap-4 p-6">
			@webhookErrorBanner(d, f.Error)
			@FormField(d, urlField) {
				<input name="url" type="url" dir="ltr" maxlength={ strconv.Itoa(f.MaxURLLen) } value={ f.URL } placeholder="https://example.com/hooks/openwa" class={ InputClass(), "font-mono" } { InputAttrs(urlField)... }/>
			}
			@webhookDeviceField(d, f)
			@FormField(d, descField) {
				<input name="description" type="text" dir="auto" maxlength={ strconv.Itoa(f.MaxDescription) } value={ f.Description } class={ InputClass() } { InputAttrs(descField)... }/>
			}
			@FieldGroup(d.Tr("webhooks.events_label")) {
				<div class="flex flex-col gap-1">
					for _, opt := range f.Events {
						@webhookEventRow(d, opt)
					}
				</div>
			}
			if f.ID != "" {
				<label class="flex min-h-11 cursor-pointer items-center justify-between gap-3 lg:min-h-8">
					<span class="text-sm font-medium">{ d.Tr("webhooks.active_label") }</span>
					<input type="checkbox" name="active" value="1" checked?={ f.Active } class="toggle toggle-success"/>
				</label>
			}
			<div class="card-actions flex-wrap justify-end gap-2">
				@AppButton(ButtonProps{Kind: ButtonGhost, Label: d.Tr("common.cancel"), Href: webhookCancelHref(d, f)})
				if f.ID == "" {
					@AppButton(ButtonProps{Kind: ButtonPrimary, Type: "submit", Icon: "plus", Label: d.Tr("webhooks.create")})
				} else {
					@AppButton(ButtonProps{Kind: ButtonPrimary, Type: "submit", Label: d.Tr("webhooks.save")})
				}
			</div>
		</div>
	</form>
}

templ WebhookNewPage(d web.LayoutData, f WebhookFormView) {
	<section id="webhook-page" class="max-w-2xl">
		@PageHeader(d, PageHeaderProps{
			Title:    d.Tr("webhooks.new_title"),
			Subtitle: d.Tr("webhooks.new_subtitle"),
			Actions:  AppButton(ButtonProps{Kind: ButtonGhost, Label: d.Tr("webhooks.back"), Href: d.ProjectPath(f.ProjectSlug, "/webhooks")}),
		})
		@webhookForm(d, f)
	</section>
}

templ WebhookNewLayout(d web.LayoutData, f WebhookFormView) {
	@Layout(web.WithContent(d, WebhookNewPage(d, f)))
}
