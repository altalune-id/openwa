package templates

import (
	"strconv"

	"altalune.id/openwa/internal/web"
)

type OverviewView struct {
	OrgSlug          string
	OrgID            string
	ProjectID        string
	ProjectSlug      string
	ProjectName      string
	Devices          int
	DevicesConnected int
	MessagesToday    int
}

templ OverviewPage(d web.LayoutData, v OverviewView) {
	<section class="space-y-6">
		@PageHeader(d, PageHeaderProps{Eyebrow: d.Tr("nav.overview"), Title: v.ProjectName})
		<div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
			@CopyValue(d, v.OrgSlug)
			<span aria-hidden="true" class="text-muted-foreground/70">·</span>
			@CopyValue(d, v.OrgID)
			<span aria-hidden="true" class="text-muted-foreground/70">/</span>
			@CopyValue(d, v.ProjectSlug)
			<span aria-hidden="true" class="text-muted-foreground/70">·</span>
			@CopyValue(d, v.ProjectID)
		</div>
		<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
			@StatCard(d.Tr("overview.devices"), d.Tr("overview.devices_value", "Total", v.Devices, "Connected", v.DevicesConnected))
			@StatCard(d.Tr("overview.messages_today"), strconv.Itoa(v.MessagesToday))
		</div>
	</section>
}

templ OverviewLayout(d web.LayoutData, v OverviewView) {
	@Layout(web.WithContent(d, OverviewPage(d, v)))
}
