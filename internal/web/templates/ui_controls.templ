package templates

import (
	"strconv"

	"altalune.id/openwa/internal/web"
	"altalune.id/openwa/internal/web/icons"
)

templ button(p ButtonProps) {
	if p.Href != "" {
		<a href={ templ.SafeURL(p.Href) } class={ ButtonClass(p.Kind) } { p.Attrs... }>
			if p.Icon != "" {
				@icons.Icon(p.Icon, "size-4 shrink-0")
			}
			if p.Label != "" {
				<span>{ p.Label }</span>
			}
		</a>
	} else {
		<button type={ buttonType(p) } class={ ButtonClass(p.Kind) } disabled?={ p.Disabled } { p.Attrs... }>
			if p.Icon != "" {
				@icons.Icon(p.Icon, "size-4 shrink-0")
			}
			if p.Label != "" {
				<span>{ p.Label }</span>
			}
		</button>
	}
}

// FormField renders a label, the control passed as children, help text and an error message.
templ FormField(d web.LayoutData, p FieldProps) {
	<div class="fieldset min-w-0 gap-1.5 py-0">
		<label for={ p.ID } class="label text-sm font-medium text-base-content">
			{ p.Label }
			if p.Required {
				<span aria-hidden="true" class="text-error">*</span>
			}
		</label>
		{ children... }
		if p.Help != "" && p.Error == "" {
			<p id={ p.ID + "-help" } class="label text-xs whitespace-normal text-base-content/70">{ p.Help }</p>
		}
		if p.Error != "" {
			<p role="alert" id={ p.ID + "-error" } class="label text-xs whitespace-normal text-error">{ p.Error }</p>
		}
	</div>
}

// FieldGroup renders a borderless daisyUI fieldset with its legend, for a group of related choices.
templ FieldGroup(legend string) {
	<fieldset class="fieldset min-w-0 py-0">
		<legend class="fieldset-legend mb-1 pt-0">{ legend }</legend>
		{ children... }
	</fieldset>
}

// Chip renders a checkbox styled as a pill.
templ Chip(p ChipProps) {
	<label class="chip badge h-auto min-h-11 cursor-pointer gap-2 border-base-300 bg-base-200 px-3 py-1 text-sm has-checked:border-primary has-checked:bg-primary/10 lg:min-h-8">
		<input type="checkbox" name={ p.Name } value={ p.Value } checked?={ p.Checked } class="checkbox checkbox-xs"/>
		<span>{ p.Label }</span>
	</label>
}

// Tabs renders the ARIA tablist pattern and its switching script.
templ Tabs(d web.LayoutData, p TabsProps) {
	<div data-tabs class="rounded-box border border-base-300 bg-base-100">
		<nav role="tablist" aria-orientation="horizontal" aria-label={ p.Label } class="tabs tabs-border overflow-x-auto px-2">
			for i, t := range p.Tabs {
				<button type="button" role="tab" class="tab whitespace-nowrap" id={ p.ID + "-tab-" + t.Key } aria-controls={ p.ID + "-panel-" + t.Key } aria-selected={ strconv.FormatBool(i == 0) } tabindex={ tabIndex(i == 0) }>{ t.Label }</button>
			}
		</nav>
		for i, t := range p.Tabs {
			<div role="tabpanel" id={ p.ID + "-panel-" + t.Key } aria-labelledby={ p.ID + "-tab-" + t.Key } { t.Attrs... } hidden?={ i != 0 } class="border-t border-base-300 p-3">
				@t.Panel
			</div>
		}
	</div>
	@tabsScript(d.Nonce)
}

templ tabsScript(nonce string) {
	<script nonce={ nonce }>
	(function() {
	if (window.openwaTabsBound) return;
	window.openwaTabsBound = true;
	var tabsOf = function(root) {
		return Array.prototype.filter.call(root.querySelectorAll('[role="tab"]'), function(t) {
			return t.closest('[data-tabs]') === root;
		});
	};
	var select = function(tab) {
		var root = tab.closest('[data-tabs]');
		if (!root) return;
		tabsOf(root).forEach(function(t) {
			var on = t === tab;
			t.setAttribute('aria-selected', on ? 'true' : 'false');
			t.classList.toggle('tab-active', on);
			t.tabIndex = on ? 0 : -1;
			var panel = document.getElementById(t.getAttribute('aria-controls'));
			if (panel) panel.hidden = !on;
		});
	};
	document.addEventListener('click', function(e) {
		if (!e.target || !e.target.closest) return;
		var tab = e.target.closest('[data-tabs] [role="tab"]');
		if (tab) select(tab);
	});
	document.addEventListener('keydown', function(e) {
		if (!e.target || !e.target.closest) return;
		var tab = e.target.closest('[data-tabs] [role="tab"]');
		if (!tab) return;
		var tabs = tabsOf(tab.closest('[data-tabs]'));
		var i = tabs.indexOf(tab);
		var step = getComputedStyle(tab).direction === 'rtl' ? -1 : 1;
		var next = null;
		if (e.key === 'ArrowRight') next = tabs[(i + step + tabs.length) % tabs.length];
		if (e.key === 'ArrowLeft') next = tabs[(i - step + tabs.length) % tabs.length];
		if (e.key === 'Home') next = tabs[0];
		if (e.key === 'End') next = tabs[tabs.length - 1];
		if (!next) return;
		e.preventDefault();
		select(next);
		next.focus();
	});
	})();
	</script>
}

// Disclosure renders a daisyUI arrow collapse around its children.
templ Disclosure(summary string) {
	<details class="collapse collapse-arrow rounded-box border border-base-300 bg-base-100">
		<summary class="collapse-title text-sm font-semibold" data-scan-asym="daisyUI collapse-title reserves its end padding for the arrow">{ summary }</summary>
		<div class="collapse-content">
			{ children... }
		</div>
	</details>
}

// CopyButton renders a button that copies value and shows label.
templ CopyButton(d web.LayoutData, value, label string) {
	@copyControl(d, value, label, label)
}

// CopyValue renders value itself as a copy button.
templ CopyValue(d web.LayoutData, value string) {
	@copyControl(d, value, value, d.Tr("common.copy")+": "+value)
}

templ copyControl(d web.LayoutData, value, text, label string) {
	<button
		type="button"
		data-copy={ value }
		data-copy-text={ text }
		data-copy-label={ label }
		data-copied-label={ d.Tr("common.copy_done") }
		aria-label={ label }
		title={ label }
		class="btn btn-ghost btn-sm h-auto min-h-11 max-w-full justify-start gap-1.5 border-base-300 bg-base-200 px-2 py-1 font-mono text-xs font-normal lg:min-h-8"
	>
		<span data-copy-slot class="min-w-0 truncate">{ text }</span>
		@icons.Icon("copy", "size-3.5 shrink-0 opacity-70")
	</button>
}

// KeyValue renders one label and value row of a definition list; long values wrap instead of clipping.
templ KeyValue(label string) {
	<div class="grid min-w-0 gap-1 sm:grid-cols-[10rem_minmax(0,1fr)] sm:items-center sm:gap-4">
		<dt class="text-sm text-base-content/70">{ label }</dt>
		<dd class="min-w-0 text-sm break-words">
			{ children... }
		</dd>
	</div>
}

// SecretField renders a read-only masked value with a copy button; the value never shows until it is copied.
templ SecretField(d web.LayoutData, id, label, value string) {
	@FormField(d, FieldProps{ID: id, Label: label}) {
		<div class="join w-full">
			<input id={ id } type="password" dir="ltr" readonly value={ value } autocomplete="off" class="input join-item w-full font-mono lg:input-sm"/>
			<button
				type="button"
				data-copy={ value }
				data-copy-label={ d.Tr("common.copy") }
				data-copied-label={ d.Tr("common.copy_done") }
				aria-label={ d.Tr("common.copy") }
				class="btn join-item lg:btn-sm"
			>
				@icons.Icon("copy", "size-4")
			</button>
		</div>
	}
}

// shownOnceProps configures shownOnce; Actions renders beside the field, e.g. "I've copied it".
type shownOnceProps struct {
	ID      string
	Title   string
	Note    string
	Label   string
	Value   string
	Actions templ.Component
}

// shownOnce renders a one-time secret: a warning alert around the kit SecretField.
templ shownOnce(d web.LayoutData, p shownOnceProps) {
	<div role="status" data-shown-once class="alert alert-warning alert-soft alert-vertical items-start sm:alert-horizontal">
		@icons.Icon("key-round", "size-5 shrink-0")
		<div class="flex w-full min-w-0 flex-col gap-2">
			<div>
				<p class="font-semibold">{ p.Title }</p>
				if p.Note != "" {
					<p class="text-sm">{ p.Note }</p>
				}
			</div>
			@SecretField(d, p.ID, p.Label, p.Value)
			if p.Actions != nil {
				<div class="flex flex-wrap items-center gap-2">
					@p.Actions
				</div>
			}
		</div>
	</div>
}

// CodeBlock renders code in a dark block with line numbers; long lines scroll inside the block.
templ CodeBlock(label, code, class string) {
	<div role="region" aria-label={ label } tabindex="0" dir="ltr" class={ "w-full max-w-full min-w-0 overflow-x-auto rounded-box bg-neutral py-4 text-start font-mono text-xs text-neutral-content", class }>
		<div class="w-max min-w-full">
			for i, line := range codeLines(code) {
				<pre class="flex leading-relaxed"><span aria-hidden="true" class="w-10 shrink-0 pe-4 text-end opacity-50">{ strconv.Itoa(i + 1) }</span><code class="pe-4">{ line }</code></pre>
			}
		</div>
	</div>
}
