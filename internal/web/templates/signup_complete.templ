package templates

import "altalune.id/openwa/internal/web"

// SignupCompleteView backs the /signup/complete form.
type SignupCompleteView struct {
	Email          string
	Name           string
	AskDisplayName bool
	AskAccept      bool
	TermsURL       string
	PrivacyURL     string
	OrgName        string
	OrgSlug        string
	ProjectName    string
	ProjectSlug    string
	FieldErrors    map[string]string
	Error          string
	ErrorCode      string
}

templ SignupCompletePage(d web.LayoutData, v SignupCompleteView) {
	{{ nameField := FieldProps{ID: "signup-name", Label: d.Tr("welcome.display_name_label"), Error: v.FieldErrors["name"], Required: true} }}
	{{ orgNameField := FieldProps{ID: "signup-org-name", Label: d.Tr("common.name"), Error: v.FieldErrors["org_name"], Required: true} }}
	{{ orgSlugField := FieldProps{ID: "signup-org-slug", Label: d.Tr("common.slug"), Help: d.Tr("common.slug_hint"), Error: v.FieldErrors["org_slug"]} }}
	{{ projectNameField := FieldProps{ID: "signup-project-name", Label: d.Tr("common.name")} }}
	{{ projectSlugField := FieldProps{ID: "signup-project-slug", Label: d.Tr("common.slug")} }}
	<section class="mx-auto max-w-xl">
		@PageHeader(d, PageHeaderProps{Eyebrow: d.Tr("welcome.eyebrow"), Title: d.Tr("signup.title"), Subtitle: d.Tr("signup.subtitle") + " " + v.Email})
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		<form method="post" action={ templ.SafeURL(d.Href("/signup/complete")) } class="mt-6 space-y-6" novalidate>
			if v.AskDisplayName {
				@Field(d, nameField) {
					<input name="name" type="text" value={ v.Name } placeholder={ d.Tr("welcome.display_name_placeholder") } class={ InputClass() } { InputAttrs(nameField)... }/>
				}
			}
			<fieldset class="space-y-3">
				<legend class="text-sm font-semibold text-foreground">{ d.Tr("signup.org_section") }</legend>
				@Field(d, orgNameField) {
					<input name="org_name" type="text" value={ v.OrgName } placeholder={ d.Tr("org_new.name_placeholder") } class={ InputClass() } { InputAttrs(orgNameField)... }/>
				}
				@Field(d, orgSlugField) {
					<input name="org_slug" type="text" value={ v.OrgSlug } placeholder={ d.Tr("org_new.slug_placeholder") } class={ InputClass() } { InputAttrs(orgSlugField)... }/>
				}
			</fieldset>
			<fieldset class="space-y-3">
				<legend class="text-sm font-semibold text-foreground">{ d.Tr("signup.project_section") }</legend>
				@Field(d, projectNameField) {
					<input name="project_name" type="text" value={ v.ProjectName } placeholder={ d.Tr("project_new.name_placeholder") } class={ InputClass() } { InputAttrs(projectNameField)... }/>
				}
				@Field(d, projectSlugField) {
					<input name="project_slug" type="text" value={ v.ProjectSlug } placeholder={ d.Tr("project_new.slug_placeholder") } class={ InputClass() } { InputAttrs(projectSlugField)... }/>
				}
			</fieldset>
			if v.AskAccept {
				<div class="flex items-start gap-2">
					<input id="signup-accept" name="accept_terms" type="checkbox" value="1" required class="mt-0.5 h-4 w-4 rounded border-border"/>
					<label for="signup-accept" class="text-sm text-foreground">
						{ d.Tr("welcome.accept_prefix") }
						if v.TermsURL != "" {
							<a href={ templ.SafeURL(v.TermsURL) } target="_blank" rel="noopener" class="font-medium underline hover:no-underline">{ d.Tr("welcome.terms_link") }</a>
						}
						if v.TermsURL != "" && v.PrivacyURL != "" {
							{ " " }{ d.Tr("welcome.and") }{ " " }
						}
						if v.PrivacyURL != "" {
							<a href={ templ.SafeURL(v.PrivacyURL) } target="_blank" rel="noopener" class="font-medium underline hover:no-underline">{ d.Tr("welcome.privacy_link") }</a>
						}
						{ d.Tr("welcome.accept_suffix") }
					</label>
				</div>
			}
			<div class="pt-2">
				@Button(ButtonProps{Kind: ButtonPrimary, Type: "submit", Label: d.Tr("signup.submit")})
			</div>
		</form>
		<form method="post" action={ templ.SafeURL(d.Href("/logout")) } class="mt-3">
			<button type="submit" class={ ButtonClass(ButtonGhost) }>{ d.Tr("welcome.wrong_account") }</button>
		</form>
	</section>
}

templ SignupCompleteLayout(d web.LayoutData, v SignupCompleteView) {
	@Layout(web.WithContent(d, SignupCompletePage(d, v)))
}
