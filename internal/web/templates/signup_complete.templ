package templates

import "altalune.id/openwa/internal/web"

// SignupCompleteView backs the /signup/complete form; FieldErrors and Error hold translation keys.
type SignupCompleteView struct {
	Email         string
	Name          string
	WorkspaceName string
	AskAccept     bool
	TermsURL      string
	PrivacyURL    string
	FieldErrors   map[string]string
	Error         string
	ErrorCode     string
}

func trKey(d web.LayoutData, key string) string {
	if key == "" {
		return ""
	}
	return d.Tr(key)
}

templ SignupCompletePage(d web.LayoutData, v SignupCompleteView) {
	{{ nameField := FieldProps{ID: "signup-name", Label: d.Tr("signup.name_label"), Help: d.Tr("signup.name_hint"), Error: trKey(d, v.FieldErrors["workspace_name"]), Required: true} }}
	<section class="mx-auto flex w-full max-w-xl flex-col gap-4 lg:gap-6">
		<form method="post" action={ templ.SafeURL(d.Href("/signup/complete")) } class="card border border-base-300 bg-base-100" novalidate>
			<div class="card-body gap-4 p-4 sm:p-6">
				<h1 class="text-2xl font-semibold text-balance">{ d.Tr("signup.title") }</h1>
				<p class="text-base-content/70">{ d.Tr("signup.lead") }</p>
				if v.Error != "" {
					@ErrorBanner(d, d.Tr(v.Error), v.ErrorCode)
				}
				@FormField(d, nameField) {
					<input
						name="workspace_name"
						type="text"
						maxlength="200"
						autocomplete="organization"
						value={ v.WorkspaceName }
						class={ InputClass(), templ.KV("input-error", nameField.Error != "") }
						{ InputAttrs(nameField)... }
					/>
				}
				if v.AskAccept {
					<label for="signup-accept" class="label min-h-11 cursor-pointer gap-3 text-sm whitespace-normal text-base-content">
						<input id="signup-accept" name="accept_terms" type="checkbox" value="1" required class="checkbox checkbox-sm"/>
						<span>
							{ d.Tr("welcome.accept_prefix") }
							if v.TermsURL != "" {
								<a href={ templ.SafeURL(v.TermsURL) } target="_blank" rel="noopener" class="link">{ d.Tr("welcome.terms_link") }</a>
							}
							if v.TermsURL != "" && v.PrivacyURL != "" {
								{ " " }{ d.Tr("welcome.and") }{ " " }
							}
							if v.PrivacyURL != "" {
								<a href={ templ.SafeURL(v.PrivacyURL) } target="_blank" rel="noopener" class="link">{ d.Tr("welcome.privacy_link") }</a>{ d.Tr("welcome.accept_suffix") }
							} else {
								{ d.Tr("welcome.accept_suffix") }
							}
						</span>
					</label>
				}
				<button type="submit" class="btn btn-primary btn-block whitespace-nowrap lg:btn-sm">{ d.Tr("signup.submit") }</button>
			</div>
		</form>
		<div class="flex flex-wrap items-center justify-center gap-x-2 text-sm text-base-content/70">
			<span>{ d.Tr("common.signed_in_as") } <strong class="break-all font-medium text-base-content">{ v.Email }</strong></span>
			<form method="post" action={ templ.SafeURL(d.Href("/logout")) }>
				<button type="submit" class={ ButtonClass(ButtonGhost) }>{ d.Tr("welcome.wrong_account") }</button>
			</form>
		</div>
	</section>
}

templ SignupCompleteLayout(d web.LayoutData, v SignupCompleteView) {
	@Layout(web.WithContent(d, SignupCompletePage(d, v)))
}
