package templates

import (
	"altalune.id/openwa/internal/web"
	"altalune.id/openwa/internal/web/icons"
)

// Badge renders a status pill in the tone's theme colors.
templ Badge(tone Tone, text string) {
	<span class={ badgeClass(tone) }>{ text }</span>
}

// StatusDot renders a labelled status dot.
templ StatusDot(tone Tone, label string) {
	<span class={ dotClass(tone) } role="img" aria-label={ label }></span>
}

// Spinner renders an htmx-indicator spinner with a screen-reader label.
templ Spinner(label string) {
	<span role="status" class="htmx-indicator inline-flex items-center gap-2 text-xs text-base-content/70">
		<span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
		<span class="sr-only">{ label }</span>
	</span>
}

// Avatar renders the initial of name in a circle.
templ Avatar(name, size string) {
	<span class={ "inline-grid shrink-0 place-items-center rounded-full bg-primary font-semibold uppercase text-primary-content", size } aria-hidden="true">{ avatarInitial(name) }</span>
}

// Toast renders one dismissible notice.
templ Toast(d web.LayoutData, kind web.FlashKind, message string) {
	<div role="status" class={ flashClass(kind), "flex w-full items-start gap-2 text-sm shadow-md" } data-toast>
		<p class="min-w-0 flex-1 break-words">{ message }</p>
		<button type="button" data-toast-dismiss aria-label={ d.Tr("common.dismiss") } class="btn btn-ghost btn-square btn-sm -my-1 -me-1 shrink-0 max-lg:btn-md">
			@icons.Icon("x", "size-4")
		</button>
	</div>
}

// ToastHost renders the live region toasts land in, with the current flash.
templ ToastHost(d web.LayoutData) {
	<div id="hx-notice" aria-live="polite" class="toast toast-bottom toast-center z-50 w-80 max-w-[calc(100vw-2rem)] whitespace-normal lg:toast-end">
		if d.Flash != nil {
			@Toast(d, d.Flash.Kind, d.Flash.Message)
		}
	</div>
	@toastScript(d.Nonce)
}

// OOBToast renders a toast as an htmx 4 partial appended to the toast host.
templ OOBToast(d web.LayoutData, kind web.FlashKind, message string) {
	<template hx type="partial" hx-target="#hx-notice" hx-swap="beforeend" hx-nonce={ d.Nonce }>
		@Toast(d, kind, message)
	</template>
}

templ toastScript(nonce string) {
	<script nonce={ nonce }>
	(function() {
		if (window.openwaToastBound) return;
		window.openwaToastBound = true;
		var region = document.getElementById('hx-notice');
		if (!region) return;
		var arm = function(toast) {
			if (!toast || toast.nodeType !== 1 || !toast.hasAttribute('data-toast') || toast.__armed) return;
			toast.__armed = true;
			var timer = setTimeout(function() { toast.remove(); }, 6000);
			toast.addEventListener('click', function(e) {
				if (e.target.closest('[data-toast-dismiss]')) { clearTimeout(timer); toast.remove(); }
			});
		};
		Array.prototype.forEach.call(region.children, arm);
		new MutationObserver(function(records) {
			records.forEach(function(r) { Array.prototype.forEach.call(r.addedNodes, arm); });
		}).observe(region, { childList: true });
	})();
	</script>
}

// ConfirmModal renders a trigger button and a modal dialog holding the real POST form; dialog.js opens and closes it.
templ ConfirmModal(d web.LayoutData, p ConfirmProps) {
	@AppButton(confirmTrigger(p))
	@ConfirmDialog(d, p)
}

// ConfirmDialog renders the confirm dialog alone; any element with ConfirmOpener(p.ID) attributes opens it.
templ ConfirmDialog(d web.LayoutData, p ConfirmProps) {
	<dialog id={ p.ID } class="modal modal-bottom sm:modal-middle" aria-labelledby={ p.ID + "-title" } data-dialog-close-on-done>
		<form
			method="post"
			action={ templ.SafeURL(p.Action) }
			if p.HxTarget != "" {
				hx-post={ p.Action }
				hx-target={ p.HxTarget }
				hx-swap={ p.HxSwap }
				hx-status:4xx="target:#hx-error swap:innerHTML"
				hx-status:5xx="target:#hx-error swap:innerHTML"
				hx-disable="find button"
				hx-nonce={ d.Nonce }
			}
			class="modal-box p-4 pb-[max(1rem,env(safe-area-inset-bottom,0px))] sm:p-6"
		>
			for _, h := range p.Hidden {
				<input type="hidden" name={ h.Name } value={ h.Value }/>
			}
			<h2 id={ p.ID + "-title" } class="text-base font-semibold">{ p.Title }</h2>
			if p.Body != "" {
				<p class="mt-2 text-sm text-base-content/70">{ p.Body }</p>
			}
			<div class="modal-action mt-6 flex-wrap">
				<button type="button" data-dialog-close class={ ButtonClass(ButtonSecondary) }>{ d.Tr("common.cancel") }</button>
				<button type="submit" class={ ButtonClass(p.Kind) }>{ confirmLabel(d, p) }</button>
			</div>
		</form>
	</dialog>
}
