package templates

import "altalune.id/openwa/internal/web"

type OnboardingView struct {
	Email       string
	DisplayName string
	ReturnTo    string
	Error       string
	ErrorCode   string
}

templ OnboardingPage(d web.LayoutData, v OnboardingView) {
	<section class="mx-auto max-w-md">
		@PageHeader(d, PageHeaderProps{Title: d.Tr("onboarding.title"), Subtitle: d.Tr("onboarding.subtitle_prefix") + " " + v.Email + d.Tr("onboarding.subtitle_suffix")})
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		<form method="post" action={ templ.SafeURL(d.Href("/onboarding")) } class="mt-6 space-y-4">
			if v.ReturnTo != "" {
				<input type="hidden" name="return_to" value={ v.ReturnTo }/>
			}
			{{ nameField := FieldProps{ID: "display_name", Label: d.Tr("onboarding.display_name"), Required: true} }}
			@Field(d, nameField) {
				<input name="display_name" type="text" value={ v.DisplayName } class={ InputClass() } { InputAttrs(nameField)... }/>
			}
			<label class="flex items-start gap-2 text-sm text-foreground">
				<input type="checkbox" name="accept_terms" value="1" required class="mt-1 h-4 w-4 rounded border-border"/>
				<span>{ d.Tr("onboarding.accept") }</span>
			</label>
			<button type="submit" class={ ButtonClass(ButtonPrimary), "w-full justify-center" }>{ d.Tr("onboarding.submit") }</button>
		</form>
	</section>
}

templ OnboardingLayout(d web.LayoutData, v OnboardingView) {
	@Layout(web.WithContent(d, OnboardingPage(d, v)))
}
