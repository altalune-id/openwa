package templates

import (
	"altalune.id/openwa/internal/web"
	"strconv"
)

type ErrorView struct {
	Status    int
	Title     string
	Message   string
	RequestID string
	Code      string
}

templ ErrorPage(d web.LayoutData, v ErrorView) {
	<section class="mx-auto max-w-md text-center py-12">
		<p class="text-sm uppercase tracking-widest text-base-content/70">
			if v.Status > 0 {
				{ d.Tr("error.label") + " " + strconv.Itoa(v.Status) }
			} else {
				{ d.Tr("error.label") }
			}
		</p>
		<h1 class="mt-2 text-2xl font-semibold">{ v.Title }</h1>
		if v.Message != "" {
			<p class="mt-2 text-base-content/70">{ v.Message }</p>
		}
		<div class="mt-6 flex justify-center">
			@AppButton(ButtonProps{Kind: ButtonSecondary, Label: d.Tr("error.return_home"), Href: d.Href("/")})
		</div>
		if v.Code != "" || v.RequestID != "" {
			<p class="mt-6 flex flex-wrap justify-center gap-x-3 text-xs text-base-content/70">
				if v.Code != "" {
					<span>
						{ d.Tr("error.code") }
						<code class="select-all font-mono">{ v.Code }</code>
					</span>
				}
				if v.RequestID != "" {
					<span>
						{ d.Tr("error.request_id") }
						<code class="select-all font-mono">{ v.RequestID }</code>
					</span>
				}
			</p>
		}
	</section>
}

// ErrorFragment is the compact banner htmx requests get instead of a full page.
templ ErrorFragment(d web.LayoutData, v ErrorView) {
	<div class="alt-error alert alert-soft alert-error flex-col items-start gap-1 text-sm" role="alert" data-status={ strconv.Itoa(v.Status) }>
		<strong class="font-medium">{ v.Title }</strong>
		if v.Message != "" {
			<span class="ms-1">{ v.Message }</span>
		}
		if v.Code != "" || v.RequestID != "" {
			<p class="mt-1 flex flex-wrap gap-x-3 text-xs text-base-content/70">
				if v.Code != "" {
					<span>
						{ d.Tr("error.code") }
						<code class="select-all font-mono">{ v.Code }</code>
					</span>
				}
				if v.RequestID != "" {
					<span>
						{ d.Tr("error.request_id") }
						<code class="select-all font-mono">{ v.RequestID }</code>
					</span>
				}
			</p>
		}
	</div>
}

templ ErrorLayout(d web.LayoutData, v ErrorView) {
	@Layout(web.WithContent(d, ErrorPage(d, v)))
}
