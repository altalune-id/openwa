package templates

import (
	"strconv"
	"time"

	"altalune.id/openwa/internal/web"
	"altalune.id/openwa/internal/web/icons"
)

// TimelineEntry is one line of a number's recent changes.
type TimelineEntry struct {
	At    time.Time
	Key   string
	Phone string
}

// DeviceDetailView is the number page.
// NOTE: ID is the device's public id (dev_…); the internal UUID never reaches a template.
type DeviceDetailView struct {
	ProjectSlug string
	ID          string
	Name        string
	Version     int
	State        string
	Status       SessionStatus
	Connected    bool
	Reconnecting bool
	SignedOut    bool
	Phone        string
	PushName    string
	Reason      string
	ChangedAt   time.Time
	LastMessage *time.Time
	Timeline    []TimelineEntry
	Settings    bool
	RenameValue string
	RenameError string
	Pairing     DevicePairingView
	CanManage   bool
}

func (v DeviceDetailView) path(d web.LayoutData, suffix string) string {
	return d.ProjectPath(v.ProjectSlug, "/devices/"+v.ID+suffix)
}

templ DeviceDetailPage(d web.LayoutData, v DeviceDetailView) {
	@PageHeader(d, PageHeaderProps{Title: v.Name, Subtitle: plusPhone(v.Phone), Actions: NumberStatus(d, v.Status)})
	<nav class="tabs tabs-border mb-5" aria-label={ d.Tr("devices.tabs") }>
		@numberTab(v.path(d, ""), d.Tr("devices.tab_status"), !v.Settings)
		@numberTab(v.path(d, "/rules"), d.Tr("devices.tab_rules"), false)
		@numberTab(v.path(d, "?tab=settings"), d.Tr("devices.tab_settings"), v.Settings)
	</nav>
	if v.Settings {
		@numberSettings(d, v)
	} else {
		<div class="grid gap-6 lg:grid-cols-12">
			<div class="flex min-w-0 flex-col gap-4 lg:col-span-7">
				@numberState(d, v)
				@Disclosure(d.Tr("devices.technical")) {
					<dl class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-4 gap-y-1 text-sm">
						<dt class="text-base-content/70">{ d.Tr("devices.device_id") }</dt>
						<dd class="min-w-0">
							@CopyValue(d, v.ID)
						</dd>
						<dt class="text-base-content/70">{ d.Tr("devices.push_name") }</dt>
						<dd class="break-words">{ dash(v.PushName) }</dd>
						<dt class="text-base-content/70">{ d.Tr("devices.reason") }</dt>
						<dd class="font-mono break-all">{ dash(v.Reason) }</dd>
						<dt class="text-base-content/70">{ d.Tr("devices.engine_state") }</dt>
						<dd class="font-mono break-all">{ dash(v.State) }</dd>
					</dl>
				}
			</div>
			<section class="min-w-0 lg:col-span-5" aria-labelledby="number-changes">
				<h2 id="number-changes" class="mb-2 font-semibold">{ d.Tr("devices.timeline_title") }</h2>
				<ul class="timeline timeline-vertical timeline-compact">
					for i, e := range v.Timeline {
						<li>
							if i > 0 {
								<hr/>
							}
							<div class="timeline-middle">
								@icons.Icon("clock", "size-4 text-base-content/70")
							</div>
							<div class="timeline-end timeline-box text-sm">
								<p class="font-mono text-xs text-base-content/70">
									@Time(d, e.At)
								</p>
								<p>{ d.Tr(e.Key, "Phone", plusPhone(e.Phone)) }</p>
							</div>
							if i < len(v.Timeline)-1 {
								<hr/>
							}
						</li>
					}
				</ul>
			</section>
		</div>
	}
}

templ DeviceDetailLayout(d web.LayoutData, v DeviceDetailView) {
	@Layout(web.WithContent(d, DeviceDetailPage(d, v)))
}

templ numberTab(href, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		class={ "tab text-base-content/80", templ.KV("tab-active", active) }
		if active {
			aria-current="page"
		}
	>{ label }</a>
}

templ numberState(d web.LayoutData, v DeviceDetailView) {
	switch {
		case v.Connected:
			<p role="status" class="alert alert-success alert-soft">
				@icons.Icon("circle-check", "size-5")
				<span>
					if v.LastMessage != nil {
						{ d.Tr("devices.status.connected_last") }
						{ " " }
						@Time(d, *v.LastMessage)
					} else {
						{ d.Tr("devices.status.connected_none") }
					}
				</span>
			</p>
		case v.Reconnecting:
			<div role="status" class="alert alert-warning alert-soft">
				@icons.Icon("refresh-cw", "size-5")
				<div>
					<p class="font-semibold">
						{ d.Tr("devices.status.reconnecting") }
						<span class="loading loading-dots loading-xs align-middle" aria-hidden="true"></span>
					</p>
					<p class="text-sm">{ d.Tr("devices.status.reconnecting_body") }</p>
				</div>
			</div>
		case v.SignedOut && !v.Pairing.pending():
			if v.CanManage {
				@Tip(d, "fix-it")
			}
			<div id="device-fix" role="alert" class="alert alert-error alert-soft alert-vertical sm:alert-horizontal">
				@icons.Icon("triangle-exclamation-point", "size-5")
				<div>
					<p class="font-semibold">{ d.Tr("devices.status.signed_out") }</p>
					<p class="text-sm">
						if !v.ChangedAt.IsZero() {
							@Time(d, v.ChangedAt)
							{ " · " }
						}
						{ d.Tr("devices.status.signed_out_body") }
					</p>
				</div>
				if v.CanManage {
					<form method="post" action={ templ.SafeURL(v.path(d, "/links")) } hx-post={ v.path(d, "/links") } hx-target="#device-fix" hx-swap="outerHTML" hx-disable="find button" hx-nonce={ d.Nonce } class="group w-full sm:w-auto">
						<button type="submit" data-tour="fix" class="btn btn-error btn-block sm:w-auto lg:btn-sm">
							<span class="inline-flex items-center gap-2 group-[.htmx-request]:hidden">
								@icons.Icon("refresh-cw", "size-4")
								{ d.Tr("devices.fix") }
							</span>
							<span class="hidden items-center gap-2 group-[.htmx-request]:inline-flex">
								<span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
								{ d.Tr("devices.fix_trying") }
							</span>
						</button>
					</form>
				} else {
					<p class="text-sm">{ d.Tr("common.managers_only") }</p>
				}
			</div>
		case v.Pairing.pending() && !v.SignedOut:
			<p role="status" class="alert alert-info alert-soft">
				@icons.Icon("qr-code", "size-5")
				<span>{ d.Tr("devices.status.waiting") }</span>
			</p>
			@DevicePairing(d, v.Pairing)
		case v.Pairing.pending():
			@DevicePairing(d, v.Pairing)
		default:
			<p role="status" class="alert alert-soft">
				@icons.Icon("unlink", "size-5")
				<span>{ d.Tr("devices.status.unlinked") }</span>
			</p>
			@DevicePairing(d, v.Pairing)
	}
}

templ numberSettings(d web.LayoutData, v DeviceDetailView) {
	<div class="flex max-w-2xl flex-col gap-5">
		<form method="post" action={ templ.SafeURL(v.path(d, "/rename")) }>
			<fieldset class="fieldset min-w-0 rounded-box border border-base-300 bg-base-100 p-4">
				<legend class="fieldset-legend">{ d.Tr("devices.name") }</legend>
				<input type="hidden" name="version" value={ strconv.Itoa(v.Version) }/>
				<label class="label text-base-content/80" for="rename-name">{ d.Tr("devices.name_step.label") }</label>
				<div class="join w-full">
					<input
						id="rename-name"
						type="text"
						name="name"
						value={ v.RenameValue }
						maxlength="64"
						required
						class="input join-item w-full lg:input-sm"
						if v.RenameError != "" {
							aria-invalid="true"
							aria-describedby="rename-name-error"
						}
					/>
					<button type="submit" class="btn join-item lg:btn-sm">{ d.Tr("devices.save_name") }</button>
				</div>
				if v.RenameError != "" {
					<p role="alert" id="rename-name-error" class="label text-xs whitespace-normal text-error">{ v.RenameError }</p>
				}
			</fieldset>
		</form>
		<section class="card border border-error/40 bg-base-100" aria-labelledby="number-danger">
			<div class="card-body gap-4">
				<h2 id="number-danger" class="card-title text-base">{ d.Tr("devices.danger_title") }</h2>
				if !v.CanManage {
					<p class="text-sm text-base-content/70">{ d.Tr("common.managers_only") }</p>
				} else {
				<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
					<div>
						<p class="font-medium">{ d.Tr("devices.unlink") }</p>
						<p class="text-sm text-base-content/70">{ d.Tr("devices.unlink_row") }</p>
					</div>
						@ConfirmModal(d, ConfirmProps{
							ID:           "device-unlink",
							Title:        d.Tr("devices.unlink_title", "Name", v.Name),
							Body:         d.Tr("devices.unlink_body"),
							ConfirmLabel: d.Tr("devices.unlink"),
							Kind:         ButtonSecondary,
							Action:       v.path(d, "/unlink"),
							Trigger:      ButtonProps{Kind: ButtonSecondary, Label: d.Tr("devices.unlink"), Icon: "unlink"},
						})
				</div>
				<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
					<div>
						<p class="font-medium">{ d.Tr("devices.delete") }</p>
						<p class="text-sm text-base-content/70">{ d.Tr("devices.delete_row") }</p>
					</div>
						@deviceDeleteConfirm(d, v.ProjectSlug, v.ID, v.Name, ButtonProps{Kind: ButtonDanger, Label: d.Tr("devices.delete"), Icon: "trash-2"})
				</div>
				}
			</div>
		</section>
	</div>
}

func dash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}
