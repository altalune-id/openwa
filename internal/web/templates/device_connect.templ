package templates

import (
	"strconv"
	"time"

	"altalune.id/openwa/internal/web"
	"altalune.id/openwa/internal/web/icons"
)

// DevicePairingView is the pairing panel; the handler returns it alone as the htmx fragment.
type DevicePairingView struct {
	ProjectSlug string
	DeviceID    string
	Name        string
	Outcome     string
	PNGBase64   string
	PairingCode string
	ExpiresAt   time.Time
	Linked      bool
	Phone       string
	PushName    string
	ErrorKey    string
	PhoneValue  string
	PhoneError  string
	CanManage   bool
	Flow        bool
	Relink      bool
	LocalPhones bool
	Tab         string
	FirstPaint  bool
}

// DeviceConnectView is the first-run page: start, pair, then name the number.
type DeviceConnectView struct {
	ProjectSlug string
	Error       string
	Pairing     *DevicePairingView
	Naming      *DeviceNameView
}

// DeviceNameView is the name step after a number links.
type DeviceNameView struct {
	DeviceID    string
	Version     int
	Value       string
	Phone       string
	FromProfile bool
	Error       string
}

const pairingInclude = "[name='pair_tab']:checked, #pair-phone"

func (v DevicePairingView) pending() bool { return v.Outcome == "pending" }

func (v DevicePairingView) linked() bool { return v.Outcome == "connected" || v.Linked }

func (v DevicePairingView) codeTab() bool { return v.Tab == "code" }

func (v DevicePairingView) path(d web.LayoutData, suffix string) string {
	return d.ProjectPath(v.ProjectSlug, "/devices/"+v.DeviceID+suffix)
}

func (v DevicePairingView) pollURL(d web.LayoutData) string {
	if v.Flow {
		return v.path(d, "/links/current?flow=new")
	}
	return v.path(d, "/links/current")
}

func (v DevicePairingView) nameStepURL(d web.LayoutData) string {
	return d.ProjectPath(v.ProjectSlug, "/devices/new?device="+v.DeviceID+"&step=name")
}

func (v DevicePairingView) linkedAs(d web.LayoutData) string {
	phone := "+" + v.Phone
	if v.PushName == "" {
		return d.Tr("devices.connect.linked_body_phone", "Phone", phone)
	}
	return d.Tr("devices.connect.linked_body", "Name", v.PushName, "Phone", phone)
}

func phoneHint(d web.LayoutData, local bool) string {
	if local {
		return d.Tr("devices.connect.phone_help")
	}
	return d.Tr("devices.connect.phone_help_intl")
}

func plusPhone(p string) string {
	if p == "" {
		return ""
	}
	return "+" + p
}

func countdownUntil(t time.Time) string { return strconv.FormatInt(t.UnixMilli(), 10) }

func secondsLeft(t time.Time) string {
	return strconv.Itoa(max(0, int(time.Until(t).Round(time.Second).Seconds())))
}

templ DeviceConnectPage(d web.LayoutData, v DeviceConnectView) {
	<div class={ "mx-auto w-full", templ.KV("max-w-3xl", v.Naming == nil), templ.KV("max-w-xl", v.Naming != nil) }>
		if v.Naming != nil {
			@FirstRunSteps(d, 1)
			@deviceNameStep(d, v)
		} else {
			@FirstRunSteps(d, 0)
			<section class="card border border-base-300 bg-base-100" aria-labelledby="connect-title">
				<div class="card-body gap-4">
					<h1 id="connect-title" class="text-2xl font-semibold text-balance">{ d.Tr("devices.connect.title") }</h1>
					if v.Error != "" {
						<p role="alert" class="alert alert-error alert-soft text-sm">
							@icons.Icon("circle-exclamation-point", "size-5")
							<span>{ v.Error }</span>
						</p>
					}
					if v.Pairing != nil {
						@DevicePairing(d, *v.Pairing)
					} else {
						@deviceConnectStart(d, v)
					}
				</div>
			</section>
		}
	</div>
}

templ DeviceConnectLayout(d web.LayoutData, v DeviceConnectView) {
	@Layout(web.WithContent(d, DeviceConnectPage(d, v)))
}

// FirstRunSteps renders the link, name and rules steps with every step up to active marked.
templ FirstRunSteps(d web.LayoutData, active int) {
	<ul class="steps mb-6 w-full">
		@firstRunStep(d.Tr("devices.connect.step_link"), 0, active)
		@firstRunStep(d.Tr("devices.connect.step_name"), 1, active)
		@firstRunStep(d.Tr("devices.connect.step_rules"), 2, active)
	</ul>
}

templ firstRunStep(label string, i, active int) {
	<li
		class={ "step", templ.KV("step-primary", i <= active) }
		if i == active {
			aria-current="step"
		}
	>{ label }</li>
}

templ deviceConnectStart(d web.LayoutData, v DeviceConnectView) {
	@connectWarning(d)
	<p class="text-base-content/80">{ d.Tr("devices.connect.start_body") }</p>
	<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/devices")) }>
		<button type="submit" class="btn btn-primary">
			@icons.Icon("qr-code", "size-4")
			{ d.Tr("devices.connect.start") }
		</button>
	</form>
}

templ connectWarning(d web.LayoutData) {
	<p role="note" class="alert alert-warning alert-soft text-sm">
		@icons.Icon("triangle-exclamation-point", "size-5")
		<span>{ d.Tr("devices.connect.warning") }</span>
	</p>
}

templ DevicePairing(d web.LayoutData, v DevicePairingView) {
	@Poll(d, PollProps{ID: "device-pairing", URL: v.pollURL(d), Every: "5s", Done: !v.pending(), Swap: "outerMorph", Include: pairingInclude}) {
		if v.linked() {
			@pairingLinked(d, v)
		} else if !v.CanManage {
			<p class="text-sm text-base-content/70">{ d.Tr("common.managers_only") }</p>
		} else if v.pending() && v.PNGBase64 == "" && v.PairingCode == "" {
			<div data-pairing-wait role="status" class="flex flex-col items-center gap-3">
				<div class="skeleton size-48"></div>
				<p class="text-sm text-base-content/70">{ d.Tr("devices.connect.starting") }</p>
			</div>
		} else if v.pending() {
			if v.Flow {
				<div class="mb-4">
					@connectWarning(d)
				</div>
			} else if v.Relink {
				<div role="alert" class="alert alert-warning alert-soft mb-4">
					@icons.Icon("link-2", "size-5")
					<div>
						<p class="font-semibold">{ d.Tr("devices.relink_title") }</p>
						<p class="text-sm">{ d.Tr("devices.relink_body") }</p>
					</div>
				</div>
			}
			@pairingTabs(d, v, pairingQR(d, v), pairingCode(d, v))
		} else if v.Outcome == "timeout" {
			@pairingPaused(d, v)
		} else if v.ErrorKey != "" {
			@pairingFailed(d, v)
		} else {
			@pairingTabs(d, v, pairingQRStart(d, v), pairingPhoneForm(d, v))
			<div id="device-pair-busy" class="mt-2">
				@Spinner(d.Tr("devices.connect.starting"))
			</div>
		}
	}
}

templ pairingTabs(d web.LayoutData, v DevicePairingView, qr, code templ.Component) {
	<div class="tabs tabs-box w-full" role="radiogroup" aria-label={ d.Tr("devices.connect.tabs") }>
		<label class="tab flex-1 gap-1.5 text-base-content/80">
			<input type="radio" name="pair_tab" value="qr" checked?={ !v.codeTab() }/>
			@icons.Icon("qr-code", "size-4")
			<span>{ d.Tr("devices.connect.tab_qr") }</span>
		</label>
		<div class="tab-content pt-5">
			@qr
		</div>
		<label class="tab flex-1 gap-1.5 text-base-content/80">
			<input id="pair-tab-code" type="radio" name="pair_tab" value="code" checked?={ v.codeTab() }/>
			@icons.Icon("phone", "size-4")
			<span>{ d.Tr("devices.connect.tab_code") }</span>
		</label>
		<div class="tab-content pt-5">
			@code
		</div>
	</div>
	if v.FirstPaint {
		<script nonce={ d.Nonce }>
		(function () {
			var code = document.getElementById('pair-tab-code');
			if (code && window.matchMedia('(max-width: 1023px)').matches) code.checked = true;
		})();
		</script>
	}
}

templ pairingQR(d web.LayoutData, v DevicePairingView) {
	if v.PNGBase64 == "" {
		<p class="text-sm text-base-content/80">{ d.Tr("devices.connect.qr_unavailable") }</p>
	} else {
		<div class="grid gap-6 lg:grid-cols-2 lg:items-start">
			<div class="flex flex-col items-center gap-3" data-countdown>
				<div class="rounded-box border border-base-300 bg-base-100 p-3">
					<img data-qr src={ "data:image/png;base64," + v.PNGBase64 } alt={ d.Tr("devices.qr_alt") } width="192" height="192" class="size-44 lg:size-48"/>
				</div>
				if !v.ExpiresAt.IsZero() {
					<div class="flex items-center gap-3">
						<div
							class="radial-progress text-primary"
							style="--value:100;--size:2.5rem;--thickness:4px;"
							role="progressbar"
							aria-valuenow="100"
							aria-label={ d.Tr("devices.connect.ring_label") }
							data-countdown-until={ countdownUntil(v.ExpiresAt) }
						>
							<span class="text-xs tabular-nums" data-countdown-left>{ secondsLeft(v.ExpiresAt) }</span>
						</div>
						<p class="text-sm text-base-content/70">{ d.Tr("devices.connect.countdown") }</p>
					</div>
				}
			</div>
			<div class="min-w-0">
				<h2 class="mb-1 font-semibold">{ d.Tr("devices.connect.on_phone") }</h2>
				@phoneGuide(d)
			</div>
		</div>
	}
}

templ phoneGuide(d web.LayoutData) {
	<div class="tabs tabs-border">
		<input type="radio" name="guide_tabs" class="tab text-base-content/80" aria-label={ d.Tr("devices.connect.guide_iphone") } checked/>
		<div class="tab-content pt-3">
			@guideList(d, d.Tr("devices.connect.guide_iphone_menu"))
		</div>
		<input type="radio" name="guide_tabs" class="tab text-base-content/80" aria-label={ d.Tr("devices.connect.guide_android") }/>
		<div class="tab-content pt-3">
			@guideList(d, d.Tr("devices.connect.guide_android_menu"))
		</div>
	</div>
}

templ guideList(d web.LayoutData, menu string) {
	<ol class="list">
		for i, line := range []string{d.Tr("devices.connect.guide_open"), menu, d.Tr("devices.connect.guide_link")} {
			<li class="list-row items-center">
				<span class="badge badge-sm tabular-nums">{ strconv.Itoa(i + 1) }</span>
				<span class="list-col-grow">{ line }</span>
			</li>
		}
	</ol>
}

templ pairingCode(d web.LayoutData, v DevicePairingView) {
	if v.PairingCode == "" {
		@pairingPhoneForm(d, v)
	} else {
		<div class="flex flex-col gap-3">
			<p class="text-sm text-base-content/80">{ d.Tr("devices.connect.code_instructions") }</p>
			<div class="flex flex-wrap items-center gap-3">
				<p data-pairing-code class="font-mono text-3xl font-medium tracking-widest tabular-nums">{ v.PairingCode }</p>
				@CopyButton(d, v.PairingCode, d.Tr("common.copy"))
			</div>
			if v.PhoneValue != "" {
				<p class="text-sm text-base-content/70">{ d.Tr("devices.connect.code_for", "Phone", v.PhoneValue) }</p>
			}
			<details class="collapse collapse-arrow rounded-box border border-base-300 bg-base-100">
				<summary class="collapse-title text-sm font-medium" data-scan-asym="daisyUI collapse-title reserves its end padding for the arrow">{ d.Tr("devices.connect.other_number") }</summary>
				<div class="collapse-content">
					@pairingPhoneForm(d, v)
				</div>
			</details>
		</div>
	}
}

templ pairingPhoneForm(d web.LayoutData, v DevicePairingView) {
	{{ field := FieldProps{ID: "pair-phone", Label: d.Tr("devices.connect.phone_label"), Help: phoneHint(d, v.LocalPhones), Error: v.PhoneError} }}
	<form method="post" action={ templ.SafeURL(v.path(d, "/phone-links")) } hx-post={ v.path(d, "/phone-links") } hx-target="#device-pairing" hx-swap="outerMorph" hx-indicator="#device-pair-busy" hx-nonce={ d.Nonce } class="flex flex-col gap-2">
		@pairingHidden(v, "code")
		@FormField(d, field) {
			<input type="tel" name="phone" value={ v.PhoneValue } inputmode="tel" autocomplete="tel" placeholder="0812 3456 7890" class={ InputClass() + " tabular-nums" } { InputAttrs(field)... }/>
		}
		<button type="submit" class="btn btn-primary self-start lg:btn-sm">{ d.Tr("devices.connect.get_code") }</button>
	</form>
}

templ pairingQRStart(d web.LayoutData, v DevicePairingView) {
	<form method="post" action={ templ.SafeURL(v.path(d, "/links")) } hx-post={ v.path(d, "/links") } hx-target="#device-pairing" hx-swap="outerMorph" hx-indicator="#device-pair-busy" hx-nonce={ d.Nonce }>
		@pairingHidden(v, "qr")
		<button type="submit" class="btn btn-primary lg:btn-sm">
			@icons.Icon("qr-code", "size-4")
			{ d.Tr("devices.connect.show_qr") }
		</button>
	</form>
}

templ pairingHidden(v DevicePairingView, tab string) {
	<input type="hidden" name="pair_tab" value={ tab }/>
	if v.Flow {
		<input type="hidden" name="flow" value="new"/>
	}
}

templ pairingRetry(d web.LayoutData, v DevicePairingView, label string, primary bool) {
	<form method="post" action={ templ.SafeURL(v.path(d, "/links")) } hx-post={ v.path(d, "/links") } hx-target="#device-pairing" hx-swap="outerMorph" hx-nonce={ d.Nonce }>
		@pairingHidden(v, "qr")
		<button type="submit" class={ "btn lg:btn-sm", templ.KV("btn-primary", primary) }>
			@icons.Icon("refresh-cw", "size-4")
			{ label }
		</button>
	</form>
}

templ pairingPaused(d web.LayoutData, v DevicePairingView) {
	<div class="flex flex-col items-center gap-3 text-center">
		<div class="grid size-48 place-items-center rounded-box border border-dashed border-base-300 bg-base-200 text-base-content/70">
			@icons.Icon("qr-code", "size-10")
		</div>
		<p class="font-medium">{ d.Tr("devices.connect.paused_title") }</p>
		<p class="text-sm text-base-content/70">{ d.Tr("devices.connect.paused_body") }</p>
		@pairingRetry(d, v, d.Tr("devices.connect.paused_action"), true)
	</div>
}

templ pairingFailed(d web.LayoutData, v DevicePairingView) {
	<div role="alert" class="alert alert-error alert-soft alert-vertical sm:alert-horizontal">
		@icons.Icon("circle-exclamation-point", "size-5")
		<div>
			<p class="font-semibold">{ d.Tr("devices.connect.failed_title") }</p>
			<p class="text-sm">{ d.Tr(v.ErrorKey) }</p>
		</div>
		<div class="flex flex-wrap gap-2">
			@pairingRetry(d, v, d.Tr("devices.connect.retry"), false)
			if v.Flow {
				@deviceDeleteConfirm(d, v.ProjectSlug, v.DeviceID, v.Name, ButtonProps{Kind: ButtonGhost, Label: d.Tr("devices.connect.delete"), Icon: "trash-2"})
			}
		</div>
	</div>
}

templ pairingLinked(d web.LayoutData, v DevicePairingView) {
	if v.Flow {
		<div data-paired role="status" class="flex flex-col items-center gap-3 py-6 text-center">
			<span class="grid size-14 place-items-center rounded-full bg-success text-success-content">
				@icons.Icon("check", "size-7")
			</span>
			<p class="text-lg font-semibold">{ d.Tr("devices.connect.linked_title") }</p>
			if v.Phone != "" {
				<p class="text-base-content/80">{ v.linkedAs(d) }</p>
			}
			<a href={ templ.SafeURL(v.nameStepURL(d)) } class="btn btn-primary">{ d.Tr("devices.connect.continue") }</a>
		</div>
	} else {
		<p data-paired role="status" class="alert alert-success alert-soft">
			@icons.Icon("circle-check", "size-5")
			<span>{ d.Tr("devices.connect.linked_title") }</span>
		</p>
	}
}

templ deviceDeleteConfirm(d web.LayoutData, projectSlug, deviceID, name string, trigger ButtonProps) {
	@ConfirmModal(d, ConfirmProps{
		ID:           "device-delete",
		Title:        d.Tr("devices.delete_number_title", "Name", name),
		Body:         d.Tr("devices.delete_number_body"),
		ConfirmLabel: d.Tr("devices.delete_number"),
		Kind:         ButtonDanger,
		Action:       d.ProjectPath(projectSlug, "/devices/"+deviceID+"/delete"),
		Trigger:      trigger,
	})
}

templ deviceNameStep(d web.LayoutData, v DeviceConnectView) {
	{{ n := v.Naming }}
	{{ field := FieldProps{ID: "number-name", Label: d.Tr("devices.name_step.label"), Help: plusPhone(n.Phone), Error: n.Error, Required: true} }}
	<form method="post" action={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/devices/"+n.DeviceID+"/rename")) } class="card border border-base-300 bg-base-100">
		<div class="card-body gap-4">
			<h1 class="text-2xl font-semibold text-balance">{ d.Tr("devices.name_step.title") }</h1>
			if n.FromProfile {
				<p class="text-base-content/80">{ d.Tr("devices.name_step.lead_profile") }</p>
			} else {
				<p class="text-base-content/80">{ d.Tr("devices.name_step.lead") }</p>
			}
			<input type="hidden" name="version" value={ strconv.Itoa(n.Version) }/>
			<input type="hidden" name="next" value="rules"/>
			@FormField(d, field) {
				<input type="text" name="name" value={ n.Value } maxlength="64" class={ InputClass() } { InputAttrs(field)... }/>
			}
			<div class="card-actions justify-end gap-2">
				<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/devices/"+n.DeviceID+"/rules")) } class="btn btn-ghost">{ d.Tr("devices.name_step.skip") }</a>
				<button type="submit" class="btn btn-primary">{ d.Tr("devices.name_step.save") }</button>
			</div>
		</div>
	</form>
}
