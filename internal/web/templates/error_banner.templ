package templates

import "altalune.id/openwa/internal/web"

// ErrorBanner renders an inline form error with its code and the request id.
templ ErrorBanner(d web.LayoutData, msg, code string) {
	<div role="alert" class="mt-4 rounded-md border border-destructive/30 bg-destructive/10 p-3 text-sm text-foreground">
		<p>{ msg }</p>
		if code != "" || d.RequestID != "" {
			<p class="mt-1.5 space-x-3 text-xs text-muted-foreground">
				if code != "" {
					<span>
						{ d.Tr("error.code") }
						<code class="select-all font-mono">{ code }</code>
					</span>
				}
				if d.RequestID != "" {
					<span>
						{ d.Tr("error.request_id") }
						<code class="select-all font-mono">{ d.RequestID }</code>
					</span>
				}
			</p>
		}
	</div>
}
