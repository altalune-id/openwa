package templates

import (
	"strconv"
	"time"

	"altalune.id/openwa/internal/web"
	"altalune.id/openwa/internal/web/icons"
)

// WebhookSecretMask is what the detail page shows in place of a signing secret after its one-time reveal.
const WebhookSecretMask = "whsec_••••"

type WebhookNotice struct {
	Key   string
	Count int
}

type WebhookDeliveryRow struct {
	ID             string
	EventLabelKey  string
	Status         string
	StatusLabelKey string
	Attempt        int
	LastError      string
	CreatedAt      time.Time
	NextRetry      time.Time
	Failed         bool
	Error          WebhookError
}

type WebhookAttemptRow struct {
	Attempt    int
	StatusCode int
	Error      string
	Duration   string
	CreatedAt  time.Time
	Response   WebhookResponseView
}

type WebhookResponseView struct {
	Body      string
	Pretty    string
	Truncated bool
	LimitKiB  int
	Headers   []WebhookHeaderRow
}

type WebhookHeaderRow struct {
	Name  string
	Value string
}

type WebhookPayloadView struct {
	Body    string
	Headers []WebhookHeaderRow
}

type WebhookDeliveriesView struct {
	ProjectSlug string
	EndpointID  string
	Active      bool
	MaxAttempts int
	Items       []WebhookDeliveryRow
	FailedCount int
	Notice      WebhookNotice
	Error       WebhookError
}

// WebhookDetailView carries Secret only on the response right after Create or Rotate.
// SECURITY: Secret is set solely from the service's direct return value and never persisted or logged.
type WebhookDetailView struct {
	ProjectSlug string
	Endpoint    WebhookRow
	Secret      string
	Form        WebhookFormView
	Deliveries  WebhookDeliveriesView
	Guide       WebhookGuideView
	Toast       *web.FlashMessage
}

func webhookPath(d web.LayoutData, projectSlug, endpointID, suffix string) string {
	return d.ProjectPath(projectSlug, "/webhooks/"+endpointID+suffix)
}

templ webhookSecretBanner(d web.LayoutData, secret string) {
	<div data-webhook-secret role="status" class="mt-4 rounded-md border border-warning/30 bg-warning/10 p-4 text-sm text-foreground">
		<p class="font-semibold text-warning">{ d.Tr("webhooks.secret_heading") }</p>
		<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("webhooks.secret_warning") }</p>
		<div class="mt-2 break-all rounded border border-border bg-card px-3 py-2">
			@CopyValue(d, secret)
		</div>
		@copyScript(d.Nonce)
	</div>
}

func deliveryTone(status string) Tone {
	switch status {
	case "delivered":
		return ToneSuccess
	case "failed":
		return ToneDanger
	default:
		return ToneNeutral
	}
}

templ webhookStatusBadge(d web.LayoutData, row WebhookDeliveryRow) {
	if row.StatusLabelKey != "" {
		@Badge(deliveryTone(row.Status), d.Tr(row.StatusLabelKey))
	}
}

// WebhookDeliveryItem is one delivery row; Retry swaps it in place.
templ WebhookDeliveryItem(d web.LayoutData, v WebhookDeliveriesView, row WebhookDeliveryRow) {
	<li id={ "delivery-" + row.ID } class="px-4 py-3">
		<div class="flex flex-wrap items-center gap-3">
			<div class="min-w-0 flex-1">
				<p class="flex flex-wrap items-center gap-2 text-sm">
					if row.EventLabelKey != "" {
						<span class="font-medium text-foreground">{ d.Tr(row.EventLabelKey) }</span>
					}
					@webhookStatusBadge(d, row)
					if row.Status != "" && row.Attempt == 0 {
						<span class="text-xs text-muted-foreground">{ d.Tr("webhooks.not_attempted") }</span>
					} else if row.Status != "" {
						<span class="text-xs text-muted-foreground">{ d.Tr("webhooks.attempt_label") } { webhookAttemptLabel(row.Attempt, v.MaxAttempts) }</span>
					}
				</p>
				<p class="mt-1 flex flex-wrap gap-x-1.5 text-xs text-muted-foreground">
					<code class="font-mono">{ row.ID }</code>
					if !row.CreatedAt.IsZero() {
						<span>·</span>
						<span>
							{ d.Tr("webhooks.created_label") }:
							@Time(d, row.CreatedAt)
						</span>
					}
					if !row.NextRetry.IsZero() {
						<span>·</span>
						<span>
							{ d.Tr("webhooks.next_retry_label") }:
							@Time(d, row.NextRetry)
						</span>
					}
				</p>
				if row.LastError != "" {
					<p class="mt-1 break-all border-l-2 border-destructive/30 pl-2 font-mono text-xs text-foreground">{ row.LastError }</p>
				}
			</div>
			<button
				type="button"
				hx-get={ webhookPath(d, v.ProjectSlug, v.EndpointID, "/deliveries/"+row.ID) }
				hx-nonce={ d.Nonce }
				hx-target={ "#delivery-detail-" + row.ID }
				hx-swap="innerHTML"
				hx-status:4xx="target:#hx-error swap:innerHTML"
				hx-status:5xx="target:#hx-error swap:innerHTML"
				class={ ButtonClass(ButtonSecondary) }
			>{ d.Tr("webhooks.show_details") }</button>
			if row.Failed {
				<form
					method="post"
					action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.EndpointID, "/deliveries/"+row.ID+"/retry")) }
					hx-post={ webhookPath(d, v.ProjectSlug, v.EndpointID, "/deliveries/"+row.ID+"/retry") }
					hx-nonce={ d.Nonce }
					hx-target={ "#delivery-" + row.ID }
					hx-swap="outerHTML"
					hx-disable="find button"
					hx-status:4xx="target:#hx-error swap:innerHTML"
					hx-status:5xx="target:#hx-error swap:innerHTML"
					class="inline"
				>
					<button type="submit" class={ ButtonClass(ButtonSecondary) }>{ d.Tr("webhooks.retry") }</button>
				</form>
			}
		</div>
		@webhookErrorBanner(d, row.Error)
		<div id={ "delivery-detail-" + row.ID }></div>
	</li>
}

templ webhookRetryAll(d web.LayoutData, v WebhookDeliveriesView) {
	<span id="webhook-retry-all">
		if v.FailedCount > 0 {
			<form
				method="post"
				action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.EndpointID, "/retry-failed")) }
				hx-post={ webhookPath(d, v.ProjectSlug, v.EndpointID, "/retry-failed") }
				hx-nonce={ d.Nonce }
				hx-target="#webhook-deliveries"
				hx-swap="outerHTML"
				hx-disable="find button"
				hx-status:4xx="target:#hx-error swap:innerHTML"
				hx-status:5xx="target:#hx-error swap:innerHTML"
				class="inline"
			>
				<button type="submit" class={ ButtonClass(ButtonSecondary) }>{ d.Tr("webhooks.retry_all", "Count", v.FailedCount) }</button>
			</form>
		}
	</span>
}

// WebhookDeliveries is the HTMX-swappable deliveries section; Send test and Retry all target #webhook-deliveries.
templ WebhookDeliveries(d web.LayoutData, v WebhookDeliveriesView) {
	<div id="webhook-deliveries">
		<div class="flex flex-wrap items-center justify-between gap-3">
			<h2 class="text-base font-semibold text-foreground">{ d.Tr("webhooks.deliveries_heading", "Count", len(v.Items)) }</h2>
			<div class="flex flex-wrap items-center gap-2">
				@webhookRetryAll(d, v)
				<form
					method="post"
					action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.EndpointID, "/test")) }
					hx-post={ webhookPath(d, v.ProjectSlug, v.EndpointID, "/test") }
					hx-nonce={ d.Nonce }
					hx-target="#webhook-deliveries"
					hx-swap="outerHTML"
					hx-disable="find button"
					hx-status:4xx="target:#hx-error swap:innerHTML"
					hx-status:5xx="target:#hx-error swap:innerHTML"
					class="inline"
				>
					<button type="submit" disabled?={ !v.Active } class={ ButtonClass(ButtonPrimary) }>
						@icons.Icon("send", "h-4 w-4")
						<span>{ d.Tr("webhooks.send_test") }</span>
					</button>
				</form>
			</div>
		</div>
		if v.Notice.Key != "" {
			<p data-webhook-notice role="status" class="mt-3 rounded-md border border-success/30 bg-success/10 p-3 text-sm text-foreground">{ d.Tr(v.Notice.Key, "Count", v.Notice.Count) }</p>
		}
		@webhookErrorBanner(d, v.Error)
		<div class="mt-3">
			if len(v.Items) == 0 {
				@EmptyState(d, EmptyStateProps{Icon: "send", Title: d.Tr("webhooks.deliveries_empty")})
			} else {
				@ListShell(d, "webhook-delivery-items", nil) {
					for _, row := range v.Items {
						@WebhookDeliveryItem(d, v, row)
					}
				}
			}
		</div>
	</div>
}

// WebhookRetryResult is the row a Retry swaps in, plus the refreshed Retry-all button.
templ WebhookRetryResult(d web.LayoutData, v WebhookDeliveriesView, row WebhookDeliveryRow) {
	@WebhookDeliveryItem(d, v, row)
	<template hx type="partial" hx-target="#webhook-retry-all" hx-swap="outerHTML" hx-nonce={ d.Nonce }>
		@webhookRetryAll(d, v)
	</template>
}

templ webhookHeaderTable(d web.LayoutData, headers []WebhookHeaderRow) {
	<div class="mt-1 overflow-x-auto">
		<table class="w-full text-left text-xs">
			<thead>
				<tr class="text-muted-foreground">
					<th scope="col" class="py-0.5 pr-3 font-medium">{ d.Tr("webhooks.header_name_label") }</th>
					<th scope="col" class="py-0.5 font-medium">{ d.Tr("webhooks.header_value_label") }</th>
				</tr>
			</thead>
			<tbody>
				for _, h := range headers {
					<tr>
						<td class="py-0.5 pr-3 align-top font-mono text-foreground">{ h.Name }</td>
						<td class="break-all py-0.5 align-top font-mono text-muted-foreground">{ h.Value }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ webhookAttemptResponse(d web.LayoutData, r WebhookResponseView) {
	<details data-attempt-response class="mt-1 rounded border border-border/70 bg-background">
		<summary class="cursor-pointer px-2 py-1 text-xs font-medium text-foreground">{ d.Tr("webhooks.response_heading") }</summary>
		<div class="border-t border-border/70 p-2">
			if len(r.Headers) > 0 {
				<p class="text-xs font-semibold text-foreground">{ d.Tr("webhooks.response_headers_heading") }</p>
				@webhookHeaderTable(d, r.Headers)
			}
			<div class="mt-2 flex items-center justify-between gap-2">
				<p class="text-xs font-semibold text-foreground">{ d.Tr("webhooks.response_body_heading") }</p>
				if r.Body != "" {
					@CopyButton(d, r.Body, d.Tr("webhooks.response_copy"))
				}
			</div>
			if r.Body == "" {
				<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("webhooks.response_empty") }</p>
			} else {
				<pre class="mt-1 max-h-80 overflow-auto rounded border border-border/70 bg-background p-2 font-mono text-xs text-foreground"><code>{ r.Pretty }</code></pre>
			}
			if r.Truncated {
				<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("webhooks.response_truncated", "KiB", r.LimitKiB) }</p>
			}
		</div>
	</details>
}

templ webhookPayload(d web.LayoutData, p WebhookPayloadView) {
	<div data-webhook-payload class="mt-3 rounded-md border border-border/70 bg-muted/30 p-3">
		<div class="flex items-center justify-between gap-2">
			<p class="text-xs font-semibold text-foreground">{ d.Tr("webhooks.payload_heading") }</p>
			@CopyButton(d, p.Body, d.Tr("webhooks.payload_copy"))
		</div>
		<pre class="mt-1 max-h-80 overflow-auto rounded border border-border/70 bg-background p-2 font-mono text-xs text-foreground"><code>{ p.Body }</code></pre>
		if len(p.Headers) > 0 {
			<p class="mt-3 text-xs font-semibold text-foreground">{ d.Tr("webhooks.headers_heading") }</p>
			@webhookHeaderTable(d, p.Headers)
			<p class="mt-2 text-xs text-muted-foreground">{ d.Tr("webhooks.headers_signature_note") }</p>
		}
	</div>
}

templ WebhookDeliveryDetail(d web.LayoutData, payload WebhookPayloadView, items []WebhookAttemptRow, maxAttempts int) {
	@webhookPayload(d, payload)
	<div class="mt-3 rounded-md border border-border/70 bg-muted/30 p-3">
		<p class="text-xs font-semibold text-foreground">{ d.Tr("webhooks.attempts_heading") }</p>
		if len(items) == 0 {
			<p class="mt-1 text-xs text-muted-foreground">{ d.Tr("webhooks.attempts_empty") }</p>
		}
		<ul class="mt-1 space-y-1.5">
			for i, a := range items {
				if i > 0 && items[i-1].Attempt <= a.Attempt {
					<li data-attempt-run-break class="border-t border-dashed border-border pt-1.5 text-[11px] uppercase tracking-wide text-muted-foreground">{ d.Tr("webhooks.attempts_earlier_run") }</li>
				}
				<li class="text-xs text-muted-foreground">
					<span class="font-medium text-foreground">{ webhookAttemptLabel(a.Attempt, maxAttempts) }</span>
					<span>·</span>
					<span>{ d.Tr("webhooks.status_code_label") }:
						if a.StatusCode > 0 {
							{ strconv.Itoa(a.StatusCode) }
						} else {
							{ d.Tr("webhooks.no_response") }
						}
					</span>
					<span>·</span>
					<span>{ a.Duration }</span>
					<span>·</span>
					@Time(d, a.CreatedAt)
					if a.Error != "" {
						<p class="mt-0.5 break-all border-l-2 border-destructive/30 pl-2 font-mono text-foreground">{ a.Error }</p>
					}
					if a.StatusCode > 0 {
						@webhookAttemptResponse(d, a.Response)
					}
				</li>
			}
		</ul>
	</div>
}

templ webhookDetailActions(d web.LayoutData, v WebhookDetailView) {
	@webhookActiveBadge(d, v.Endpoint.Active)
	@Button(ButtonProps{Kind: ButtonGhost, Label: d.Tr("webhooks.back"), Href: d.ProjectPath(v.ProjectSlug, "/webhooks")})
}

templ WebhookDetailPage(d web.LayoutData, v WebhookDetailView) {
	<section id="webhook-page">
		@PageHeader(d, PageHeaderProps{Eyebrow: d.Tr("nav.webhooks"), Title: v.Endpoint.URL, Subtitle: v.Endpoint.Description, Actions: webhookDetailActions(d, v)})
		<p>
			@webhookEventBadges(d, v.Endpoint.EventLabelKeys)
		</p>
		if v.Secret != "" {
			@webhookSecretBanner(d, v.Secret)
		}
		<div class="mt-6">
			@Card(CardProps{Title: d.Tr("webhooks.secret_section")}) {
				<p class="flex flex-wrap items-center gap-2 text-sm">
					<code class="font-mono">{ WebhookSecretMask }</code>
					if v.Endpoint.Rotating {
						@Badge(ToneWarning, d.Tr("webhooks.rotating"))
					}
				</p>
				if v.Endpoint.Rotating {
					<p class="mt-2 text-xs text-muted-foreground">{ d.Tr("webhooks.rotating_help") }</p>
					<div class="mt-2">
						@ConfirmDialog(d, ConfirmProps{
							ID:           "retire-" + v.Endpoint.ID,
							Title:        d.Tr("webhooks.retire_confirm_title"),
							Body:         d.Tr("webhooks.retire_confirm_body"),
							ConfirmLabel: d.Tr("webhooks.retire"),
							Kind:         ButtonDanger,
							Action:       webhookPath(d, v.ProjectSlug, v.Endpoint.ID, "/retire"),
							Trigger:      ButtonProps{Kind: ButtonSecondary, Label: d.Tr("webhooks.retire")},
						})
					</div>
				}
				<div class="mt-3">
					@Disclosure(d.Tr("webhooks.rotate")) {
						<p class="text-xs text-muted-foreground">{ d.Tr("webhooks.rotate_warning") }</p>
						if v.Endpoint.Rotating {
							<p class="mt-1 text-xs text-warning">{ d.Tr("webhooks.rotate_replaces_secondary") }</p>
						}
						<form
							method="post"
							action={ templ.SafeURL(webhookPath(d, v.ProjectSlug, v.Endpoint.ID, "/rotate")) }
							hx-post={ webhookPath(d, v.ProjectSlug, v.Endpoint.ID, "/rotate") }
							hx-nonce={ d.Nonce }
							hx-target="#webhook-page"
							hx-swap="outerHTML"
							hx-disable="find button"
							hx-status:4xx="target:#hx-error swap:innerHTML"
							hx-status:5xx="target:#hx-error swap:innerHTML"
							class="mt-2"
						>
							@Button(ButtonProps{Kind: ButtonSecondary, Type: "submit", Label: d.Tr("webhooks.rotate_confirm")})
						</form>
					}
				</div>
			}
		</div>
		@WebhookVerifyPanel(d, v.Guide)
		<div class="mt-6">
			<h2 class="mb-2 text-base font-semibold text-foreground">{ d.Tr("webhooks.settings_section") }</h2>
			@webhookForm(d, v.Form)
		</div>
		<div class="mt-6">
			@WebhookDeliveries(d, v.Deliveries)
		</div>
		@copyScript(d.Nonce)
		<div class="mt-6">
			@Card(CardProps{Title: d.Tr("webhooks.delete"), Description: d.Tr("webhooks.delete_warning")}) {
				@ConfirmDialog(d, ConfirmProps{
					ID:           "delete-" + v.Endpoint.ID,
					Title:        d.Tr("webhooks.delete_confirm_title"),
					Body:         d.Tr("webhooks.delete_confirm_body"),
					ConfirmLabel: d.Tr("webhooks.delete_confirm"),
					Kind:         ButtonDanger,
					Action:       webhookPath(d, v.ProjectSlug, v.Endpoint.ID, "/delete"),
					Trigger:      ButtonProps{Kind: ButtonDanger, Icon: "trash-2", Label: d.Tr("webhooks.delete")},
				})
			}
		</div>
		if v.Toast != nil {
			@OOBToast(d, v.Toast.Kind, v.Toast.Message)
		}
	</section>
}

templ WebhookDetailLayout(d web.LayoutData, v WebhookDetailView) {
	@Layout(web.WithContent(d, WebhookDetailPage(d, v)))
}
