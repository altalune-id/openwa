package templates

import "altalune.id/openwa/internal/web"

type ProjectNewView struct {
	OrgSlug   string
	Slug      string
	Name      string
	Error     string
	ErrorCode string
}

templ ProjectNewPage(d web.LayoutData, v ProjectNewView) {
	<section class="mx-auto max-w-xl">
		@PageHeader(d, PageHeaderProps{Title: d.Tr("nav.create_project"), Subtitle: projectNewSubtitle(d)})
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		{{ nameField := FieldProps{ID: "project-name", Label: d.Tr("common.name"), Required: true} }}
		{{ slugField := FieldProps{ID: "project-slug", Label: d.Tr("common.slug"), Help: d.Tr("common.slug_hint")} }}
		<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/projects")) } class="mt-6 space-y-5" novalidate>
			@Field(d, nameField) {
				<input name="name" type="text" autofocus value={ v.Name } placeholder={ d.Tr("project_new.name_placeholder") } class={ InputClass() } { InputAttrs(nameField)... }/>
			}
			@Field(d, slugField) {
				<input name="slug" type="text" value={ v.Slug } placeholder={ d.Tr("project_new.slug_placeholder") } pattern="[a-z0-9-]+" class={ InputClass() } { InputAttrs(slugField)... }/>
			}
			<div class="flex items-center gap-3 pt-2">
				@Button(ButtonProps{Kind: ButtonPrimary, Type: "submit", Label: d.Tr("nav.create_project")})
				@Button(ButtonProps{Kind: ButtonGhost, Label: d.Tr("common.cancel"), Href: d.OrgPath("/projects")})
			</div>
		</form>
	</section>
}

func projectNewSubtitle(d web.LayoutData) string {
	if d.ActiveOrg != nil {
		return d.Tr("project_new.subtitle_prefix") + d.ActiveOrg.Name + "."
	}
	return d.Tr("project_new.subtitle_prefix") + d.Tr("project_new.subtitle_fallback")
}

templ ProjectNewLayout(d web.LayoutData, v ProjectNewView) {
	@Layout(web.WithContent(d, ProjectNewPage(d, v)))
}
