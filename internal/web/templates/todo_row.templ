package templates

import (
	"altalune.id/openwa/internal/web"
	"altalune.id/openwa/internal/web/icons"
)

type TodoRow struct {
	ID          string
	Title       string
	Done        bool
	OrgSlug     string
	ProjectSlug string
}

templ TodoRowFragment(d web.LayoutData, t TodoRow) {
	<li id={ "todo-" + t.ID } class="group flex items-center gap-3 px-4 py-3 hover:bg-muted/50">
		<form
			method="post"
			action={ templ.SafeURL(d.ProjectPath(t.ProjectSlug, "/todos/" + t.ID + "/toggle")) }
			hx-post={ d.ProjectPath(t.ProjectSlug, "/todos/" + t.ID + "/toggle") }
			hx-nonce={ d.Nonce }
			hx-target={ "#todo-" + t.ID }
			hx-swap="outerHTML"
			hx-disable="find button, find input"
			hx-status:4xx="target:#hx-error swap:innerHTML"
			hx-status:5xx="target:#hx-error swap:innerHTML"
			class="inline"
		>
			<button
				type="submit"
				aria-label={ "Toggle " + t.Title }
				class={
					"flex size-5 items-center justify-center rounded border text-xs transition",
					templ.KV("border-success bg-success text-success-foreground", t.Done),
					templ.KV("border-border bg-card hover:border-muted-foreground", !t.Done),
				}
			>
				if t.Done {
					@icons.Icon("check", "h-3.5 w-3.5")
				}
			</button>
		</form>
		<span class={ "flex-1 text-sm", templ.KV("text-muted-foreground line-through", t.Done), templ.KV("text-foreground", !t.Done) }>{ t.Title }</span>
		<form
			method="post"
			action={ templ.SafeURL(d.ProjectPath(t.ProjectSlug, "/todos/" + t.ID + "/delete")) }
			hx-delete={ d.ProjectPath(t.ProjectSlug, "/todos/" + t.ID) }
			hx-nonce={ d.Nonce }
			hx-target={ "#todo-" + t.ID }
			hx-swap="outerHTML"
			hx-disable="find button, find input"
			hx-status:4xx="target:#hx-error swap:innerHTML"
			hx-status:5xx="target:#hx-error swap:innerHTML"
			class="inline"
		>
			<button
				type="submit"
				aria-label={ "Delete " + t.Title }
				class="rounded-md p-1 text-muted-foreground opacity-0 transition group-hover:opacity-100 hover:bg-destructive/10 hover:text-destructive focus:opacity-100"
			>
				@icons.Icon("trash-2", "h-4 w-4")
			</button>
		</form>
	</li>
}
