package templates

import (
	"strconv"

	"altalune.id/openwa/internal/web"
)

type WebhookRow struct {
	ID             string
	URL            string
	Description    string
	EventLabelKeys []string
	Active         bool
	Rotating       bool
}

type WebhooksView struct {
	ProjectSlug string
	Items       []WebhookRow
	Limit       int
	Guide       WebhookGuideView
}

// WebhookError is one banner: a message key, its error code, and the limit its copy names.
type WebhookError struct {
	Key  string
	Code string
	Max  int
}

templ webhookErrorBanner(d web.LayoutData, e WebhookError) {
	if e.Key != "" {
		@ErrorBanner(d, d.Tr(e.Key, "Max", e.Max), e.Code)
	}
}

templ webhookActiveBadge(d web.LayoutData, active bool) {
	if active {
		@Badge(ToneSuccess, d.Tr("webhooks.active"))
	} else {
		@Badge(ToneNeutral, d.Tr("webhooks.inactive"))
	}
}

templ webhookEventBadges(d web.LayoutData, keys []string) {
	<span class="flex flex-wrap gap-1">
		for _, k := range keys {
			@Badge(ToneNeutral, d.Tr(k))
		}
	</span>
}

templ webhooksActions(d web.LayoutData, v WebhooksView) {
	<span class="text-xs text-muted-foreground">{ d.Tr("webhooks.count", "Count", len(v.Items), "Limit", v.Limit) }</span>
	if len(v.Items) < v.Limit {
		@Button(ButtonProps{Kind: ButtonPrimary, Icon: "plus", Label: d.Tr("webhooks.new"), Href: d.ProjectPath(v.ProjectSlug, "/webhooks/new")})
	}
}

templ WebhooksPage(d web.LayoutData, v WebhooksView) {
	<section>
		@PageHeader(d, PageHeaderProps{Eyebrow: d.Tr("nav.group_developer"), Title: d.Tr("webhooks.title"), Subtitle: d.Tr("webhooks.subtitle"), Actions: webhooksActions(d, v)})
		if len(v.Items) == 0 {
			@EmptyState(d, EmptyStateProps{Icon: "send", Title: d.Tr("webhooks.empty")})
		} else {
			@ListShell(d, "webhook-list", nil) {
				for _, e := range v.Items {
					@ListRow(d, nil) {
						<div class="min-w-0 flex-1">
							<a href={ templ.SafeURL(d.ProjectPath(v.ProjectSlug, "/webhooks/"+e.ID)) } class="block truncate font-mono text-sm font-medium text-foreground hover:underline">{ e.URL }</a>
							if e.Description != "" {
								<p class="mt-0.5 truncate text-xs text-muted-foreground">{ e.Description }</p>
							}
							<p class="mt-1.5">
								@webhookEventBadges(d, e.EventLabelKeys)
							</p>
						</div>
						if e.Rotating {
							@Badge(ToneWarning, d.Tr("webhooks.rotating"))
						}
						@webhookActiveBadge(d, e.Active)
					}
				}
			}
		}
		@WebhookGuide(d, v.Guide)
	</section>
}

templ WebhooksLayout(d web.LayoutData, v WebhooksView) {
	@Layout(web.WithContent(d, WebhooksPage(d, v)))
}

func webhookAttemptLabel(n, limit int) string {
	return strconv.Itoa(n) + "/" + strconv.Itoa(limit)
}
