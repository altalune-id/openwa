package templates

import (
	"altalune.id/openwa/internal/legal"
	"altalune.id/openwa/internal/web"
)

// LegalView carries a parsed legal document to the layout.
type LegalView struct {
	Doc *legal.Document
}

templ LegalPage(d web.LayoutData, v LegalView) {
	<section class="mx-auto max-w-2xl">
		@PageHeader(d, PageHeaderProps{Eyebrow: d.Tr("legal.eyebrow"), Title: v.Doc.Title, Subtitle: legalUpdated(d, v)})
		<article class="surface prose p-6">
			@templ.Raw(v.Doc.HTML)
		</article>
	</section>
}

func legalUpdated(d web.LayoutData, v LegalView) string {
	if v.Doc.UpdatedAt.IsZero() {
		return ""
	}
	return d.Tr("legal.updated_at") + " " + v.Doc.UpdatedAt.Format("2 Jan 2006")
}

templ LegalLayout(d web.LayoutData, v LegalView) {
	@Layout(web.WithContent(d, LegalPage(d, v)))
}
