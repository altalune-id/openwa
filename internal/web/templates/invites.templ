package templates

import (
	"time"

	"altalune.id/openwa/internal/web"
)

type InviteRow struct {
	ID        string
	Email     string
	Role      string
	ExpiresAt time.Time
}

type InvitesView struct {
	OrgSlug   string
	Invites   []InviteRow
	CanManage bool
	Disabled  bool
	Error     string
	ErrorCode string
}

templ InvitesPage(d web.LayoutData, v InvitesView) {
	<section>
		@PageHeader(d, PageHeaderProps{Title: d.Tr("invites.title"), Subtitle: d.Tr("invites.subtitle")})
		if v.Disabled {
			<div role="status" class="mt-4 rounded-md border border-warning/30 bg-warning/10 p-3 text-sm text-foreground">{ d.Tr("invites.disabled_banner") }</div>
		}
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if len(v.Invites) == 0 {
			@EmptyState(d, EmptyStateProps{Icon: "mail", Title: d.Tr("invites.empty")})
		} else {
			@ListShell(d, "invite-list", nil) {
				for _, i := range v.Invites {
					@ListRow(d, nil) {
						<div class="min-w-0 flex-1">
							<p class="truncate text-sm font-medium text-foreground">{ i.Email }</p>
							<p class="truncate text-xs text-muted-foreground">
								{ i.Role } · { d.Tr("invites.expires") }
								@Time(d, i.ExpiresAt)
							</p>
						</div>
						if v.CanManage {
							@ConfirmDialog(d, ConfirmProps{
								ID:           "revoke-" + i.ID,
								Title:        d.Tr("invites.revoke_confirm_title"),
								Body:         d.Tr("invites.revoke_confirm_body", "Email", i.Email),
								ConfirmLabel: d.Tr("invites.revoke"),
								Kind:         ButtonDanger,
								Action:       d.Href("/orgs/" + v.OrgSlug + "/invites/" + i.ID + "/revoke"),
								Trigger:      ButtonProps{Kind: ButtonIcon, Icon: "trash-2", Attrs: templ.Attributes{"aria-label": d.Tr("invites.revoke") + ": " + i.Email}},
							})
						}
					}
				}
			}
		}
		if v.CanManage && !v.Disabled {
			{{ emailField := FieldProps{ID: "invite-email", Label: d.Tr("invites.form_email"), Required: true} }}
			{{ roleField := FieldProps{ID: "invite-role", Label: d.Tr("invites.form_role"), Required: true} }}
			<div class="mt-8">
				@Card(CardProps{Title: d.Tr("invites.form_heading"), Description: d.Tr("invites.form_subtitle")}) {
					<form method="post" action={ templ.SafeURL(d.Href("/orgs/" + v.OrgSlug + "/invites")) } class="space-y-5">
						@Field(d, emailField) {
							<input name="email" type="email" class={ InputClass() } { InputAttrs(emailField)... }/>
						}
						@Field(d, roleField) {
							<select name="role" class={ InputClass() } { InputAttrs(roleField)... }>
								<option value="member">{ d.Tr("invites.role_member") }</option>
								<option value="admin">{ d.Tr("invites.role_admin") }</option>
							</select>
						}
						@Button(ButtonProps{Kind: ButtonPrimary, Type: "submit", Icon: "send", Label: d.Tr("invites.submit")})
					</form>
				}
			</div>
		}
	</section>
}

templ InvitesLayout(d web.LayoutData, v InvitesView) {
	@Layout(web.WithContent(d, InvitesPage(d, v)))
}
