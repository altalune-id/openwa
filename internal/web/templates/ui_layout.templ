package templates

import (
	"altalune.id/openwa/internal/web"
	"altalune.id/openwa/internal/web/icons"
)

// PageHeader renders the page h1 with an optional eyebrow, subtitle and actions at the end.
templ PageHeader(d web.LayoutData, p PageHeaderProps) {
	<header class="mb-6 flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
		<div class="min-w-0 flex-[1_1_12rem]">
			if p.Eyebrow != "" {
				<p class="text-xs font-medium text-base-content/70">{ p.Eyebrow }</p>
			}
			<h1 class="flex min-h-11 items-center text-xl font-semibold text-balance break-words lg:min-h-8">{ p.Title }</h1>
			if p.Subtitle != "" {
				<p class="mt-1 text-sm text-pretty text-base-content/70">{ p.Subtitle }</p>
			}
		</div>
		if p.Actions != nil {
			<div class="flex shrink-0 flex-wrap items-center gap-2">
				@p.Actions
			</div>
		}
	</header>
}

// Breadcrumb renders d.Crumbs as a daisyUI breadcrumbs trail above the page from lg.
templ Breadcrumb(d web.LayoutData) {
	if len(d.Crumbs) > 0 {
		<nav aria-label={ d.Tr("nav.breadcrumb") } class="breadcrumbs mb-2 hidden py-0 text-xs text-base-content/70 lg:block">
			<ol>
				for i, c := range d.Crumbs {
					<li>
						if c.Href != "" && i == len(d.Crumbs)-1 {
							<a href={ templ.SafeURL(c.Href) } aria-current="page" class="text-base-content">{ c.Label }</a>
						} else if c.Href != "" {
							<a href={ templ.SafeURL(c.Href) }>{ c.Label }</a>
						} else {
							<span aria-current="page" class="text-base-content">{ c.Label }</span>
						}
					</li>
				}
			</ol>
		</nav>
	}
}

// Card renders a bordered daisyUI card with an optional heading around its children.
templ Card(p CardProps) {
	<section class="card min-w-0 border border-base-300 bg-base-100">
		<div class="card-body min-w-0 gap-0 p-4">
			if p.Title != "" {
				<h2 class="card-title text-base">{ p.Title }</h2>
			}
			if p.Description != "" {
				<p class="mt-1 text-sm text-base-content/70">{ p.Description }</p>
			}
			if p.Title != "" || p.Description != "" {
				<div class="mt-4 min-w-0">
					{ children... }
				</div>
			} else {
				{ children... }
			}
		</div>
	</section>
}

// StatCard renders one KPI tile; a long value wraps instead of clipping.
templ StatCard(label, value string) {
	<div class="stats w-full min-w-0 border border-base-300 bg-base-100">
		<div class="stat min-w-0 place-items-start p-4">
			<p class="stat-title text-xs font-medium whitespace-normal text-base-content/70">{ label }</p>
			<p class="stat-value mt-2 min-w-0 text-2xl font-semibold break-words whitespace-normal">{ value }</p>
		</div>
	</div>
}

// ListShell renders the divided list container; hx- attributes in attrs get hx-nonce added.
templ ListShell(d web.LayoutData, id string, attrs templ.Attributes) {
	<ul id={ id } class="list rounded-box border border-base-300 bg-base-100" { withNonce(d, attrs)... }>
		{ children... }
	</ul>
}

// ListRow renders one list row; hx- attributes in attrs get hx-nonce added.
templ ListRow(d web.LayoutData, attrs templ.Attributes) {
	<li class="list-row flex min-w-0 flex-wrap items-center gap-3 px-4 py-3" { withNonce(d, attrs)... }>
		{ children... }
	</li>
}

// EmptyState renders an icon, one sentence and one primary action, centered in a card.
templ EmptyState(d web.LayoutData, p EmptyStateProps) {
	<div class="card border border-dashed border-base-300 bg-base-100">
		<div class="card-body items-center gap-2 p-8 text-center">
			if p.Icon != "" {
				@icons.Icon(p.Icon, "size-8 text-base-content/70")
			}
			<p class="text-sm font-medium">{ p.Title }</p>
			if p.Body != "" {
				<p class="text-sm text-base-content/70">{ p.Body }</p>
			}
			if p.CTA != nil {
				<div class="card-actions mt-2 justify-center">
					@AppButton(*p.CTA)
				</div>
			}
		</div>
	</div>
}

// Poll wraps children in a self-replacing polling element that stops once Done is set.
templ Poll(d web.LayoutData, p PollProps) {
	if p.Done {
		<div id={ p.ID }>
			{ children... }
		</div>
	} else {
		<div
			id={ p.ID }
			hx-get={ p.URL }
			hx-trigger={ "every " + p.Every }
			hx-swap="outerHTML"
			hx-status:4xx="target:#hx-error swap:innerHTML"
			hx-status:5xx="swap:none"
			hx-nonce={ d.Nonce }
		>
			{ children... }
		</div>
	}
}

// SplitPaneProps configures SplitPane.
type SplitPaneProps struct {
	ID     string
	List   templ.Component
	Detail templ.Component
}

// SplitPane renders a list column beside a detail section that stacks below the lg breakpoint.
templ SplitPane(p SplitPaneProps) {
	<div id={ p.ID } class="flex flex-col gap-4 lg:flex-row lg:items-start">
		<aside class="w-full shrink-0 lg:w-80">
			@p.List
		</aside>
		<section id={ p.ID + "-detail" } aria-live="polite" class="min-w-0 flex-1">
			@p.Detail
		</section>
	</div>
}
