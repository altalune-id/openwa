package templates

import "altalune.id/openwa/internal/web"

type OrgNewView struct {
	Slug      string
	Name      string
	Error     string
	ErrorCode string
}

templ OrgNewPage(d web.LayoutData, v OrgNewView) {
	<section class="mx-auto max-w-xl">
		@PageHeader(d, PageHeaderProps{Title: d.Tr("nav.create_organization"), Subtitle: d.Tr("org_new.subtitle")})
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		{{ nameField := FieldProps{ID: "org-name", Label: d.Tr("common.name"), Required: true} }}
		{{ slugField := FieldProps{ID: "org-slug", Label: d.Tr("common.slug"), Help: d.Tr("common.slug_hint")} }}
		<form method="post" action={ templ.SafeURL(d.Href("/orgs")) } class="mt-6 space-y-5" novalidate>
			@Field(d, nameField) {
				<input name="name" type="text" autofocus value={ v.Name } placeholder={ d.Tr("org_new.name_placeholder") } class={ InputClass() } { InputAttrs(nameField)... }/>
			}
			@Field(d, slugField) {
				<input name="slug" type="text" value={ v.Slug } placeholder={ d.Tr("org_new.slug_placeholder") } pattern="[a-z0-9-]+" class={ InputClass() } { InputAttrs(slugField)... }/>
			}
			<div class="flex items-center gap-3 pt-2">
				@Button(ButtonProps{Kind: ButtonPrimary, Type: "submit", Label: d.Tr("nav.create_organization")})
				@Button(ButtonProps{Kind: ButtonGhost, Label: d.Tr("common.cancel"), Href: d.Href("/")})
			</div>
		</form>
	</section>
}

templ OrgNewLayout(d web.LayoutData, v OrgNewView) {
	@Layout(web.WithContent(d, OrgNewPage(d, v)))
}
