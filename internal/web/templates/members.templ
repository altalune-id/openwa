package templates

import "altalune.id/openwa/internal/web"

type MemberRow struct {
	UserID    string
	Email     string
	Name      string
	Role      string
	System    bool
	IsSelf    bool
	Removable bool
}

type MembersView struct {
	OrgSlug   string
	Members   []MemberRow
	CanManage bool
	Error     string
	ErrorCode string
}

templ membersActions(d web.LayoutData, v MembersView) {
	if v.CanManage {
		@Button(ButtonProps{Kind: ButtonPrimary, Icon: "user-plus", Label: d.Tr("members.invite_button"), Href: d.Href("/orgs/" + v.OrgSlug + "/invites")})
	}
}

templ MembersPage(d web.LayoutData, v MembersView) {
	<section>
		@PageHeader(d, PageHeaderProps{Title: d.Tr("members.title"), Subtitle: d.Tr("members.subtitle"), Actions: membersActions(d, v)})
		if v.Error != "" {
			@ErrorBanner(d, v.Error, v.ErrorCode)
		}
		if len(v.Members) == 0 {
			@EmptyState(d, EmptyStateProps{Icon: "users", Title: d.Tr("members.empty")})
		} else {
			@ListShell(d, "member-list", nil) {
				for _, m := range v.Members {
					@ListRow(d, nil) {
						<div class="min-w-0 flex-1">
							<p class="flex items-center gap-2 truncate text-sm font-medium text-foreground">
								<span class="truncate">{ memberDisplayName(m) }</span>
								if m.IsSelf {
									@Badge(ToneNeutral, d.Tr("members.you"))
								}
								if m.System {
									@Badge(ToneWarning, d.Tr("common.system"))
								}
							</p>
							<p class="truncate text-xs text-muted-foreground">{ m.Email } · { m.Role }</p>
						</div>
						if v.CanManage && m.Removable {
							@ConfirmDialog(d, ConfirmProps{
								ID:           "remove-" + m.UserID,
								Title:        d.Tr("members.remove_confirm_title"),
								Body:         d.Tr("members.remove_confirm_body", "Email", m.Email),
								ConfirmLabel: d.Tr("members.remove"),
								Kind:         ButtonDanger,
								Action:       d.Href("/orgs/" + v.OrgSlug + "/members/" + m.UserID + "/remove"),
								Trigger:      ButtonProps{Kind: ButtonIcon, Icon: "trash-2", Attrs: templ.Attributes{"aria-label": d.Tr("members.remove") + ": " + m.Email}},
							})
						}
					}
				}
			}
		}
	</section>
}

func memberDisplayName(m MemberRow) string {
	if m.Name != "" {
		return m.Name
	}
	return m.Email
}

templ MembersLayout(d web.LayoutData, v MembersView) {
	@Layout(web.WithContent(d, MembersPage(d, v)))
}
