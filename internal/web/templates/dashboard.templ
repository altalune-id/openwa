package templates

import "altalune.id/openwa/internal/web"

type DashboardView struct {
	OrgName      string
	OrgSlug      string
	Orgs         []OrgSummary
	Projects     []ProjectSummary
	ActiveProjID string
}

type OrgSummary struct {
	ID     string
	Slug   string
	Name   string
	System bool
}

type ProjectSummary struct {
	ID     string
	Slug   string
	Name   string
	System bool
}

templ DashboardPage(d web.LayoutData, v DashboardView) {
	<section>
		@PageHeader(d, PageHeaderProps{
			Title:    dashboardTitle(d, v),
			Subtitle: d.Tr("dashboard.subtitle"),
			Actions:  newProjectAction(d, d.Tr("dashboard.new_project")),
		})
		if len(v.Projects) == 0 {
			@EmptyState(d, EmptyStateProps{Icon: "folder", Title: d.Tr("dashboard.empty_title"), Body: d.Tr("dashboard.empty_body"), CTA: newProjectCTA(d)})
		} else {
			<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
				for _, p := range v.Projects {
					<li>
						<a href={ templ.SafeURL(d.ProjectPath(p.Slug, "/overview")) } class="rounded-box border border-base-300 bg-base-100 block h-full p-4 transition hover:shadow-md">
							<div class="flex flex-wrap items-baseline justify-between gap-x-2 gap-y-1">
								<p class="min-w-[12ch] flex-1 truncate text-sm font-medium text-foreground">{ p.Name }</p>
								<div class="flex shrink-0 items-center gap-1.5">
									if p.ID == v.ActiveProjID {
										@Badge(ToneNeutral, d.Tr("common.current"))
									}
									if p.System {
										@Badge(ToneWarning, d.Tr("common.system"))
									}
								</div>
							</div>
							<p class="mt-1 text-xs text-muted-foreground">{ p.Slug }</p>
						</a>
					</li>
				}
			</ul>
		}
	</section>
}

func dashboardTitle(d web.LayoutData, v DashboardView) string {
	if v.OrgName != "" {
		return v.OrgName
	}
	return d.Tr("dashboard.title")
}

templ DashboardLayout(d web.LayoutData, v DashboardView) {
	@Layout(web.WithContent(d, DashboardPage(d, v)))
}

templ createProjectManagersOnly(d web.LayoutData) {
	<span class="flex min-h-11 items-center text-xs text-base-content/70 lg:min-h-8">{ d.Tr("projects.create_managers_only") }</span>
}
