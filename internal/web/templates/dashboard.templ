package templates

import "altalune.id/openwa/internal/web"

type DashboardView struct {
	OrgName      string
	OrgSlug      string
	Orgs         []OrgSummary
	Projects     []ProjectSummary
	ActiveProjID string
}

type OrgSummary struct {
	ID     string
	Slug   string
	Name   string
	System bool
}

type ProjectSummary struct {
	ID     string
	Slug   string
	Name   string
	System bool
}

templ DashboardPage(d web.LayoutData, v DashboardView) {
	<section>
		@PageHeader(d, PageHeaderProps{
			Title:    dashboardTitle(d, v),
			Subtitle: d.Tr("dashboard.subtitle"),
			Actions:  Button(ButtonProps{Kind: ButtonPrimary, Icon: "plus", Label: d.Tr("dashboard.new_project"), Href: d.OrgPath("/projects/new")}),
		})
		if len(v.Projects) == 0 {
			@EmptyState(d, EmptyStateProps{Icon: "folder", Title: d.Tr("dashboard.empty_title"), Body: d.Tr("dashboard.empty_body"), CTA: &ButtonProps{Kind: ButtonPrimary, Label: d.Tr("projects.create_first"), Href: d.OrgPath("/projects/new")}})
		} else {
			<ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
				for _, p := range v.Projects {
					<li>
						<a href={ templ.SafeURL(d.ProjectPath(p.Slug, "/overview")) } class="surface block p-4 transition hover:shadow-md">
							<div class="flex items-baseline justify-between gap-2">
								<p class="truncate text-sm font-medium text-foreground">{ p.Name }</p>
								<div class="flex shrink-0 items-center gap-1.5">
									if p.ID == v.ActiveProjID {
										@Badge(ToneNeutral, d.Tr("common.current"))
									}
									if p.System {
										@Badge(ToneWarning, d.Tr("common.system"))
									}
								</div>
							</div>
							<p class="mt-1 text-xs text-muted-foreground">{ p.Slug }</p>
						</a>
					</li>
				}
			</ul>
		}
	</section>
}

func dashboardTitle(d web.LayoutData, v DashboardView) string {
	if v.OrgName != "" {
		return v.OrgName
	}
	return d.Tr("dashboard.title")
}

templ DashboardLayout(d web.LayoutData, v DashboardView) {
	@Layout(web.WithContent(d, DashboardPage(d, v)))
}
