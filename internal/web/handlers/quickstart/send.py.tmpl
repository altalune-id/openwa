import os

import requests

BASE = "{{.Base}}"
DEVICE = "{{.Device}}"

res = requests.post(
    f"{BASE}/devices/{DEVICE}/messages",
    headers={"Authorization": f"Bearer {os.environ['KEY']}"},
    json={"to": "628111222333", "text": "Hello from OpenWA"},
    timeout=10,
)
print(res.status_code, res.json())
