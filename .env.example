OPENWA_TOKENS_CLOCK_SKEW=60s
# tokens.supportedAlgs
OPENWA_TOKENS_SUPPORTED_ALGS=RS256,ES256
# tokens.acceptRS256
OPENWA_TOKENS_ACCEPT_RS256=

# ── cloud only ──
# [required, mode:cloud] tokens.issuer
OPENWA_TOKENS_ISSUER=
# [required, mode:cloud] tokens.jwksURL
OPENWA_TOKENS_JWKS_URL=

# ─── webhook ───

# ── selfhosted only ──
# [mode:selfhosted] webhook.allowInsecure
OPENWA_WEBHOOK_ALLOW_INSECURE=false

# ─── whatsapp ───
# whatsapp.clientName
OPENWA_WHATSAPP_CLIENT_NAME=OpenWA
# whatsapp.leaseTTL
OPENWA_WHATSAPP_LEASE_TTL=45s
# whatsapp.leaseInterval
OPENWA_WHATSAPP_LEASE_INTERVAL=15s
# whatsapp.linkTimeout
OPENWA_WHATSAPP_LINK_TIMEOUT=3m
# whatsapp.parkFor
OPENWA_WHATSAPP_PARK_FOR=0s
# whatsapp.inboundQueueSize
OPENWA_WHATSAPP_INBOUND_QUEUE_SIZE=1024
# whatsapp.sendSpacingMin
OPENWA_WHATSAPP_SEND_SPACING_MIN=1s
# whatsapp.sendSpacingMax
OPENWA_WHATSAPP_SEND_SPACING_MAX=3s
# whatsapp.mediaMaxBytes
OPENWA_WHATSAPP_MEDIA_MAX_BYTES=33554432
# whatsapp.typingBeforeText
OPENWA_WHATSAPP_TYPING_BEFORE_TEXT=true
