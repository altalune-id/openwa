OPENWA_ONBOARD_SETUP_TOKEN=

# ─── queue ───
# queue.enabled
OPENWA_QUEUE_ENABLED=false
# [secret] queue.url
OPENWA_QUEUE_URL=
# [secret] queue.token
OPENWA_QUEUE_TOKEN=
# queue.user
OPENWA_QUEUE_USER=
# [secret] queue.password
OPENWA_QUEUE_PASSWORD=
