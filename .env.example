OPENWA_TENANT_PERSONAL_ORG_SLUG_FALLBACK=personal
# tenant.personalProjectSlug
OPENWA_TENANT_PERSONAL_PROJECT_SLUG=

# ─── tokens ───
# tokens.jwksCacheTTL
OPENWA_TOKENS_JWKS_CACHE_TTL=
