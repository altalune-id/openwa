OPENWA_OIDC_END_SESSION_ON_LOGOUT=

# ── cloud only ──
# [required, mode:cloud] oidc.issuer
OPENWA_OIDC_ISSUER=
# [required, mode:cloud] oidc.clientID
OPENWA_OIDC_CLIENT_ID=
# [required, mode:cloud, secret] oidc.clientSecret
OPENWA_OIDC_CLIENT_SECRET=

# ─── onboard ───
