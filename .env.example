# openwa — auto-generated from internal/platform/config struct tags.
# DO NOT edit by hand. Run `go tool gen-config-example` to regenerate.
#
# Awareness markers on each field (in [brackets] above the env var):
#   required   — must be non-empty for the app to boot (in the applicable mode)
#   bootstrap  — set once at first-run; changing later has no effect or breaks things
#   secret     — never commit; use env vars or a secret store
#   mode:X     — only applies in the given mode (selfhosted | cloud)
#
# Fields split into two top-level sections:
#   BOOTSTRAP — locked at first boot, changing later is NOT SAFE
#   RUNTIME   — safe to change via env + restart
#
# RHS shows the built-in default when present. Secret fields intentionally
# emit no RHS value, even if a default exists internally.


# ════════════════════════════════════════════════════════════════════
#   BOOTSTRAP — set once at first boot; changing later is NOT SAFE
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section lock in behavior for the lifetime of the deployment:
#   - Changing them via env vars after first boot has NO effect on already-
#     persisted data.
#   - Some fields are secrets used to sign existing tokens/cookies
#     (http.stateSecret) — rotating invalidates in-flight sessions.
#   - Some fields are database-layer decisions (schema, tablePrefix) that
#     require SQL-level intervention to change.
#
# Read every line here BEFORE first `openwa serve`. Set them deliberately.
#
# ────────────────────────────────────────────────────────────────────

# ─── db ───
# [bootstrap] db.schema
OPENWA_DB_SCHEMA=public
# [bootstrap] db.tablePrefix
OPENWA_DB_TABLE_PREFIX=openwa_
# [bootstrap] db.role
OPENWA_DB_ROLE=
# [secret, bootstrap] db.migrator.dsn
OPENWA_DB_MIGRATOR_DSN=
# [bootstrap] db.migrator.role
OPENWA_DB_MIGRATOR_ROLE=
# [bootstrap] db.reader.role
OPENWA_DB_READER_ROLE=
# [bootstrap] db.allowBypassRLS
OPENWA_DB_ALLOW_BYPASS_RLS=

# ─── genesis ───
# [bootstrap, secret] genesis.password
OPENWA_GENESIS_PASSWORD=

# ── cloud only ──
# [bootstrap, mode:cloud] genesis.breakGlass
OPENWA_GENESIS_BREAK_GLASS=false

# ─── http ───
# [required, secret, bootstrap] http.stateSecret
OPENWA_HTTP_STATE_SECRET=

# ─── i18n ───
# [required, bootstrap] i18n.defaultLocale
OPENWA_I18N_DEFAULT_LOCALE=en-US

# ─── log ───
# [bootstrap] log.redactPatterns
OPENWA_LOG_REDACT_PATTERNS=

# ─── media ───
# [bootstrap] media.store
OPENWA_MEDIA_STORE=wa

# ─── mode ───
# [required, bootstrap] mode
OPENWA_MODE=selfhosted

# ─── scheduler ───
# [bootstrap] scheduler.enabled
OPENWA_SCHEDULER_ENABLED=true
# [bootstrap] scheduler.timezone
OPENWA_SCHEDULER_TIMEZONE=UTC

# ─── security ───
# [required, secret, bootstrap] security.encryptionKey
OPENWA_SECURITY_ENCRYPTION_KEY=

# ─── tenant ───
# [bootstrap] tenant.rlsEnforce
OPENWA_TENANT_RLS_ENFORCE=true
# [bootstrap] tenant.singletonOrg.slug
OPENWA_TENANT_SINGLETON_ORG_SLUG=
# [bootstrap] tenant.singletonOrg.name
OPENWA_TENANT_SINGLETON_ORG_NAME=Default Organization
# [bootstrap] tenant.tenantScopedTables
OPENWA_TENANT_TENANT_SCOPED_TABLES=

# ─── tokens ───

# ── cloud only ──
# [required, mode:cloud, bootstrap] tokens.audience
OPENWA_TOKENS_AUDIENCE=urn:openwa:api

# ─── whatsapp ───
# [bootstrap] whatsapp.engine
OPENWA_WHATSAPP_ENGINE=whatsmeow


# ════════════════════════════════════════════════════════════════════
#   RUNTIME — safe to change via env + restart
# ════════════════════════════════════════════════════════════════════
#
# Fields in this section can be adjusted between deployments without
# affecting persisted data. Restarting the app picks up the new values.
#
# ────────────────────────────────────────────────────────────────────

# ─── api ───
# api.enabled
OPENWA_API_ENABLED=true
# api.keyPrefix
OPENWA_API_KEY_PREFIX=key_
# api.openapi.enabled
OPENWA_API_OPENAPI_ENABLED=true
# api.openapi.requireBasicAuth
OPENWA_API_OPENAPI_REQUIRE_BASIC_AUTH=true
# api.openapi.basicAuthUser
OPENWA_API_OPENAPI_BASIC_AUTH_USER=
# [secret] api.openapi.basicAuthPassword
OPENWA_API_OPENAPI_BASIC_AUTH_PASSWORD=

# ─── blog ───
# blog.publicReads
OPENWA_BLOG_PUBLIC_READS=

# ─── brand ───
# brand.name
OPENWA_BRAND_NAME=OpenWA

# ─── compliance ───
# compliance.termsURL
OPENWA_COMPLIANCE_TERMS_URL=
# compliance.privacyURL
OPENWA_COMPLIANCE_PRIVACY_URL=
# compliance.requireAcceptance
OPENWA_COMPLIANCE_REQUIRE_ACCEPTANCE=

# ─── dataplane ───
# dataplane.enabled
OPENWA_DATAPLANE_ENABLED=true

# ─── db ───
# [required, secret] db.dsn
OPENWA_DB_DSN=
# [secret] db.reader.dsn
OPENWA_DB_READER_DSN=
# db.reader.maxOpenConns
OPENWA_DB_READER_MAX_OPEN_CONNS=
# db.reader.maxIdleConns
OPENWA_DB_READER_MAX_IDLE_CONNS=
# db.reader.connMaxLifetime
OPENWA_DB_READER_CONN_MAX_LIFETIME=
# db.reader.connMaxIdleTime
OPENWA_DB_READER_CONN_MAX_IDLE_TIME=
# db.health.interval
OPENWA_DB_HEALTH_INTERVAL=30s
# db.health.timeout
OPENWA_DB_HEALTH_TIMEOUT=2s
# db.autoMigrate
OPENWA_DB_AUTO_MIGRATE=true
# db.maxOpenConns
OPENWA_DB_MAX_OPEN_CONNS=
# db.maxIdleConns
OPENWA_DB_MAX_IDLE_CONNS=
# db.connMaxLifetime
OPENWA_DB_CONN_MAX_LIFETIME=
# db.connMaxIdleTime
OPENWA_DB_CONN_MAX_IDLE_TIME=
# db.connectTimeout
OPENWA_DB_CONNECT_TIMEOUT=30s
# db.connectBackoff
OPENWA_DB_CONNECT_BACKOFF=250ms

# ─── genesis ───
# genesis.email
OPENWA_GENESIS_EMAIL=

# ─── http ───
# [required] http.addr
OPENWA_HTTP_ADDR=:5150
# http.basePath
OPENWA_HTTP_BASE_PATH=
# [required] http.baseURL
OPENWA_HTTP_BASE_URL=
# http.cookieSecure
OPENWA_HTTP_COOKIE_SECURE=false
# http.robotsTxt
OPENWA_HTTP_ROBOTS_TXT=
# [required] http.csp.enabled
OPENWA_HTTP_CSP_ENABLED=true
# http.csp.reportOnly
OPENWA_HTTP_CSP_REPORT_ONLY=false
# http.csp.reportURI
OPENWA_HTTP_CSP_REPORT_URI=

# ─── log ───
# log.level
OPENWA_LOG_LEVEL=info
# log.format
OPENWA_LOG_FORMAT=json
# log.addSource
OPENWA_LOG_ADD_SOURCE=

# ─── mail ───
# mail.driver
OPENWA_MAIL_DRIVER=console
# mail.from
OPENWA_MAIL_FROM=no-reply@openwa.local
# mail.smtp.host
OPENWA_MAIL_SMTP_HOST=
# mail.smtp.port
OPENWA_MAIL_SMTP_PORT=587
# mail.smtp.user
OPENWA_MAIL_SMTP_USER=
# [secret] mail.smtp.pass
OPENWA_MAIL_SMTP_PASS=
# mail.smtp.tls
OPENWA_MAIL_SMTP_TLS=true
# [secret] mail.resend.apiKey
OPENWA_MAIL_RESEND_API_KEY=
# mail.resend.endpoint
OPENWA_MAIL_RESEND_ENDPOINT=
# mail.resend.maxAttempts
OPENWA_MAIL_RESEND_MAX_ATTEMPTS=3

# ─── mcp ───
# mcp.enabled
OPENWA_MCP_ENABLED=
# mcp.audience
OPENWA_MCP_AUDIENCE=
# mcp.audienceOverride
OPENWA_MCP_AUDIENCE_OVERRIDE=
# mcp.appsUI
OPENWA_MCP_APPS_UI=
# mcp.challengeToken
OPENWA_MCP_CHALLENGE_TOKEN=
