OPENWA_OBSERVABILITY_REPORTER_MIN_SEVERITY=error
# observability.reporter.sinks
OPENWA_OBSERVABILITY_REPORTER_SINKS=

# ─── oidc ───
# oidc.resource
OPENWA_OIDC_RESOURCE=
