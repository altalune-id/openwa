OPENWA_SCHEDULER_SHUTDOWN_GRACE=30s

# ─── session ───
# session.path
OPENWA_SESSION_PATH=~/.openwa/session.json

# ─── telemetry ───
# telemetry.otlp.endpoint
OPENWA_TELEMETRY_OTLP_ENDPOINT=
# telemetry.otlp.protocol
OPENWA_TELEMETRY_OTLP_PROTOCOL=
# telemetry.otlp.insecure
OPENWA_TELEMETRY_OTLP_INSECURE=
# [secret] telemetry.otlp.headers
OPENWA_TELEMETRY_OTLP_HEADERS=
# telemetry.tracing.enabled
OPENWA_TELEMETRY_TRACING_ENABLED=false
# telemetry.tracing.sampleRatio
OPENWA_TELEMETRY_TRACING_SAMPLE_RATIO=
# telemetry.metrics.enabled
OPENWA_TELEMETRY_METRICS_ENABLED=false
